/* NKA custom styles (M3-compliant overrides only) */
.nka-aura-btn {
  position: relative;
  border: none;
  background: none;
  outline: none;
  cursor: pointer;
  border-radius: var(--md-sys-percent-50);
  padding: var(--md-sys-spacing-2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.aura-glow {
  background: radial-gradient(circle, var(--md-sys-color-primary80) var(--md-sys-percent-0), transparent var(--md-sys-percent-70));
  animation: m3-emphasized-pulse var(--md-sys-motion-duration-long) infinite;
}
@keyframes m3-emphasized-pulse {
  var(--md-sys-percent-0)   { transform: scale(1);  opacity: 0.4; }
  var(--md-sys-percent-50)  { transform: scale(1.08); opacity: 0.2; }
  var(--md-sys-percent-100) { transform: scale(1);  opacity: 0.4; }
}
.nka-badge {
  position: absolute;
  top: var(--md-sys-spacing-1);
  right: var(--md-sys-spacing-1);
  width: var(--md-sys-spacing-3);
  height: var(--md-sys-spacing-3);
  background: var(--md-sys-color-primary30);
  border-radius: var(--md-sys-percent-50);
  border: var(--md-sys-spacing-1) solid var(--md-sys-color-surface);
}

.nka-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.32);
  z-index: var(--md-sys-z-tooltip);
  backdrop-filter: blur(var(--md-sys-spacing-0));
}

.nka-bottom-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--md-sys-color-surface-container-lowest);
  box-shadow: var(--md-sys-elevation3);
  border-radius: var(--md-sys-shape-corner-large) var(--md-sys-spacing-6) 0 0;
  z-index: var(--md-sys-z-modal);
  min-height: 40vh;
  padding: var(--md-sys-spacing-4);
  animation: emphasized-enter 150ms cubic-bezier(.2,0,0,1);
}

.nka-close-btn {
  position: absolute;
  top: var(--md-sys-spacing-2);
  right: var(--md-sys-spacing-4);
  background: none;
  border: none;
  font-size: var(--md-sys-typescale-headline-small-size);
  color: var(--md-sys-color-on-surface-variant);
  cursor: pointer;
}
.nka-node-card {
  margin: var(--md-sys-spacing-3) 0;
  padding: var(--md-sys-spacing-4);
  background: var(--md-sys-color-surface);
  box-shadow: var(--md-sys-elevation1);
  border-radius: var(--md-sys-shape-corner-large);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: box-shadow var(--md-sys-motion-duration-short);
}
.nka-shape-circle {
  border-radius: var(--md-sys-shape-corner-full);
}
.nka-shape-pill {
  border-radius: var(--md-sys-shape-corner-full);
}
.nka-node-label {
  font-weight: 600;
  font-size: var(--md-sys-typescale-title-small-size);
}
.nka-node-depth {
  font-size: var(--md-sys-typescale-body-small-size);
  color: var(--md-sys-color-on-surface-variant);
  margin-bottom: var(--md-sys-spacing-2);
}
.nka-node-actions {
  display: flex;
  gap: var(--md-sys-spacing-2);
}
.nka-action-btn {
  background: none;
  border: none;
  color: var(--md-sys-color-primary);
  font-weight: 500;
  cursor: pointer;
  padding: var(--md-sys-spacing-1) var(--md-sys-spacing-2);
  border-radius: var(--md-sys-shape-corner-small);
  transition: background var(--md-sys-motion-duration-short);
}
.nka-action-btn:hover {
  background: var(--md-sys-color-primary10);
}
.nka-settings-toggle {
  display: flex;
  flex-direction: column;
  gap: var(--md-sys-spacing-1);
  margin: var(--md-sys-spacing-4) 0;
}
.nka-settings-subtitle {
  font-size: var(--md-sys-typescale-body-small-size);
  color: var(--md-sys-color-on-surface-variant);
}


