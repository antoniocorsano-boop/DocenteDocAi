# DocenteDoc AI — Backend Environment Variables
# Copy to .env and fill in real values (NEVER commit .env to git)

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the deployed React client (Vercel/Netlify URL, no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_64_BYTE_HEX

# ─── KeyVault PBKDF2 ──────────────────────────────────────────────────────────
# Used as HMAC key to derive per-user PBKDF2 salts.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: changing this value invalidates ALL user-encrypted data.
KEY_VAULT_SECRET=REPLACE_ME_WITH_64_BYTE_HEX

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / Render Postgres / local)
# If not set, audit logs fall back to structured console.log
DATABASE_URL=postgres://user:password@host:5432/docentedoc

# ─── Monitoring (P27 — optional) ─────────────────────────────────────────────
# Sentry DSN for server-side error tracking.
# Leave empty to disable Sentry (default for local dev).
# Get your DSN from: https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=

# Winston file logging — set to an absolute path to enable file transports.
# Logs written to $LOG_DIR/error.log and $LOG_DIR/combined.log
# If not set, logs are console-only (suitable for Render/Heroku log drains).
# LOG_DIR=/var/log/docentedoc

# Prometheus /metrics endpoint.
# In production, protect with IP allowlist on your load balancer / reverse proxy.
# Grafana datasource: HTTP → URL = https://your-backend.onrender.com/metrics

# ─── Google OAuth (P28) ───────────────────────────────────────────────────────
# Google Cloud Console → Credenziali → OAuth 2.0 → Client ID
# Stesso CLIENT_ID usato dal frontend (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# ─── Stripe (P28) ─────────────────────────────────────────────────────────────
# Secret key da dashboard Stripe → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Webhook secret: Stripe dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price ID del prodotto Pro mensile (Stripe dashboard → Products → Pro → Price)
STRIPE_PRICE_ID=price_REPLACE_ME
