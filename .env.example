# Example environment variables
# To enable GSI in development, set:
# VITE_ENABLE_GSI_DEV=true
# VITE_GSI_CLIENT_ID=your-dev-google-client-id.apps.googleusercontent.com

# OpenTelemetry tracing (optional — leave unset to disable tracing)
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Do NOT commit secrets or production client IDs to source control.