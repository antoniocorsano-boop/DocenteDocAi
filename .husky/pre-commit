#!/bin/sh
. "$(dirname "$0")/_/husky.sh"


npx lint-staged

# MD3 Compliance Pre-commit Hook - Active Enforcement
echo "🔍 Running MD3 Compliance Audit..."

# Get staged TSX/TS files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx?|jsx?)$' | grep '^src/' || true)

if [ -n "$STAGED_FILES" ]; then
    echo "📁 Checking staged components: $STAGED_FILES"

    # Use a Windows-friendly temp file path
    TEMP_FILE="./scripts/md3-staged-files.txt"
    # Write staged files to temp file (cross-platform)
    echo "$STAGED_FILES" | tr ' ' '\n' > "$TEMP_FILE"

    # Run MD3 expressive audit script (update path if needed)
    node ./scripts/md3/audit-md3-expressive.cjs

    SCAN_EXIT_CODE=$?

    # Clean up
    rm -f /tmp/md3-staged-files.txt

    if [ $SCAN_EXIT_CODE -ne 0 ]; then
        echo "❌ MD3 Compliance check failed!"
        echo "🚫 Commit blocked due to MD3 violations in staged files."
        echo ""
        echo "📋 To fix violations:"
        echo "   1. Run 'npm run md3:scan' to see detailed violations"
        echo "   2. Use 'npm run md3:migrate' to fix individual components"
        echo "   3. Or run batch migrations: 'npm run md3:migrate:batch:simple'"
        echo ""
        echo "🔗 See MD3_MIGRATION_BATCH_TODO.md for migration guidelines"
        exit 1
    fi

    echo "✅ MD3 Compliance check passed for staged files!"
else
    echo "ℹ️  No TSX/TS components staged - skipping MD3 compliance check"
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PHASE 4 - STEP 4: Z-INDEX GOVERNANCE ENFORCEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo ""
echo "🔍 Running MD3 Z-INDEX Governance Audit..."

node ./scripts/md3/md3-zindex-audit.cjs

ZINDEX_EXIT_CODE=$?

if [ $ZINDEX_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ MD3 Z-INDEX GOVERNANCE FAILED"
    echo "🚫 COMMIT BLOCKED: Numeric z-index values detected"
    echo ""
    echo "📖 All z-index must use MD3 tokens: var(--md-sys-z-*)"
    echo "📘 See: docs/MD3_Z_INDEX_GOVERNANCE.md"
    exit 1
fi

echo "✅ Z-INDEX Governance check passed!"
echo ""
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PHASE 5 - MOTION & DURATION GOVERNANCE ENFORCEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo "🔍 Running MD3 MOTION Governance Audit..."

node ./scripts/md3/md3-motion-audit.cjs

MOTION_EXIT_CODE=$?

if [ $MOTION_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ MD3 MOTION GOVERNANCE FAILED"
    echo "🚫 COMMIT BLOCKED: Hardcoded motion/duration values detected"
    echo ""
    echo "📖 All motion must use MD3 tokens: var(--md-sys-motion-*)"
    echo "📘 See: docs/MD3_MOTION_GOVERNANCE.md"
    exit 1
fi

echo "✅ MOTION Governance check passed!"
echo ""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PHASE 6 - COMPONENT CONTRACT ENFORCEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo "🔍 Running MD3 COMPONENT CONTRACT Audit..."

node ./scripts/md3/md3-component-contract-audit.cjs

COMPONENT_EXIT_CODE=$?

if [ $COMPONENT_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ MD3 COMPONENT CONTRACT FAILED"
    echo "🚫 COMMIT BLOCKED: Component-level violations detected"
    echo ""
    echo "📖 Components must not use inline styles or forbidden props"
    echo "📘 See: docs/MD3_COMPONENT_CONTRACTS.md"
    exit 1
fi

echo "✅ COMPONENT CONTRACT check passed!"
echo ""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PHASE 7 - THEME & TOKEN ENFORCEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo "🔍 Running MD3 THEME Audit..."

node ./scripts/md3/md3-theme-audit.cjs

THEME_EXIT_CODE=$?

if [ $THEME_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ MD3 THEME GOVERNANCE FAILED"
    echo "🚫 COMMIT BLOCKED: Hardcoded theme values detected"
    echo ""
    echo "📖 All colors, spacing, typography must use MD3 tokens"
    echo "📘 See: MD3_GOVERNANCE_COMPLIANCE_CONTRACT.md"
    exit 1
fi

echo "✅ THEME Governance check passed!"
echo ""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PHASE 8 - PATTERN-BASED MD3 VIOLATION DETECTION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo "🔍 Running MD3 Pattern Violation Scan..."

# Get staged content for pattern analysis
STAGED_CONTENT=$(git diff --cached --name-only | xargs -I {} sh -c 'git show :{}' | cat 2>/dev/null || true)

if [ -n "$STAGED_CONTENT" ]; then
    # Pattern: Hardcoded percentages (excluding MD3 tokens)
    if echo "$STAGED_CONTENT" | grep -q "[^a-z-][0-9]\+%[^a-z-]" | grep -v "var(--md-sys-percent-"; then
        echo "❌ FORBIDDEN: Hardcoded percentage values detected"
        echo "🚫 Use: var(--md-sys-percent-*) tokens only"
        echo "📖 Reference: MD3_GOLD_MANIFESTO.md"
        exit 1
    fi

    # Pattern: Hardcoded viewport units
    if echo "$STAGED_CONTENT" | grep -q "[0-9]\+\(vh\|vw\|vmin\|vmax\)"; then
        echo "❌ FORBIDDEN: Hardcoded viewport units detected"
        echo "🚫 Use: var(--md-sys-viewport-*) tokens only"
        echo "📖 Reference: MD3_GOLD_MANIFESTO.md"
        exit 1
    fi

    # Pattern: Hardcoded motion durations/easings
    if echo "$STAGED_CONTENT" | grep -q "\b[0-9]\+\(\.[0-9]\+\)\?\(ms\|s\)\b\|\bease\b\|\bease-in\b\|\bease-out\b\|\bease-in-out\b\|\blinear\b" | grep -v "var(--md-sys-motion-"; then
        echo "❌ FORBIDDEN: Hardcoded motion values detected"
        echo "🚫 Use: var(--md-sys-motion-*) tokens only"
        echo "📖 Reference: MD3_GOLD_MANIFESTO.md"
        exit 1
    fi

    # Pattern: Hardcoded z-index values
    if echo "$STAGED_CONTENT" | grep -q "z-index:\s*[0-9]\+" | grep -v "var(--md-sys-z-"; then
        echo "❌ FORBIDDEN: Hardcoded z-index values detected"
        echo "🚫 Use: var(--md-sys-z-*) tokens only"
        echo "📖 Reference: MD3_GOLD_MANIFESTO.md"
        exit 1
    fi

    # Pattern: Hardcoded grid fr units
    if echo "$STAGED_CONTENT" | grep -q "[0-9]\+fr" | grep -v "var(--md-sys-grid-fr-"; then
        echo "❌ FORBIDDEN: Hardcoded grid fr units detected"
        echo "🚫 Use: var(--md-sys-grid-fr-*) tokens only"
        echo "📖 Reference: MD3_GOLD_MANIFESTO.md"
        exit 1
    fi

    # Pattern: margin: auto
    if echo "$STAGED_CONTENT" | grep -q "margin:\s*auto" | grep -v "var(--md-sys-margin-auto)"; then
        echo "❌ FORBIDDEN: margin: auto detected"
        echo "🚫 Use: var(--md-sys-margin-auto) token only"
        echo "📖 Reference: MD3_GOLD_MANIFESTO.md"
        exit 1
    fi
fi

echo "✅ Pattern-based MD3 violation scan passed!"
echo ""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PRE-COMMIT SUMMARY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
