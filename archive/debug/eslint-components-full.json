{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":126,"column":34,"nodeType":"JSXAttribute","endLine":126,"endColumn":70},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":131,"column":34,"nodeType":"JSXAttribute","endLine":131,"endColumn":70},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":132,"column":36,"nodeType":"JSXAttribute","endLine":132,"endColumn":72},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":133,"column":36,"nodeType":"JSXAttribute","endLine":133,"endColumn":72},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":140,"column":33,"nodeType":"JSXAttribute","endLine":140,"endColumn":71},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":147,"column":30,"nodeType":"JSXAttribute","endLine":147,"endColumn":62},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":149,"column":32,"nodeType":"JSXAttribute","endLine":149,"endColumn":69},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":158,"column":14,"nodeType":"JSXAttribute","endLine":158,"endColumn":43},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":159,"column":18,"nodeType":"JSXAttribute","endLine":159,"endColumn":57},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":165,"column":90,"nodeType":"JSXAttribute","endLine":165,"endColumn":194},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level2)]' not allowed. Use MD3 tokens in inline styles.","line":165,"column":90,"nodeType":"JSXAttribute","endLine":165,"endColumn":194},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-large)]' not allowed. Use MD3 tokens in inline styles.","line":165,"column":90,"nodeType":"JSXAttribute","endLine":165,"endColumn":194},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":178,"column":17,"nodeType":"JSXAttribute","endLine":178,"endColumn":70},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-primary-container/20' not allowed. Use MD3 tokens in inline styles.","line":178,"column":17,"nodeType":"JSXAttribute","endLine":178,"endColumn":70},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-primary/20' not allowed. Use MD3 tokens in inline styles.","line":178,"column":17,"nodeType":"JSXAttribute","endLine":178,"endColumn":70},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":181,"column":19,"nodeType":"JSXAttribute","endLine":181,"endColumn":44},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'min-h-[500px]' not allowed. Use MD3 tokens in inline styles.","line":181,"column":19,"nodeType":"JSXAttribute","endLine":181,"endColumn":44}],"suppressedMessages":[],"errorCount":28,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * KnowledgeBase.tsx\r\n * // M3Expressive refactor: Removed inline Tailwind classes, applied dedicated CSS classes with M3 tokens for layout, colors, spacing, and typography.\r\n */\r\n\r\nimport React, { useState, useMemo } from 'react';\r\nimport { KnowledgeBaseEntry, Corpus, AiSettings, TimetableSettings } from '../types';\r\nimport AddSourceModal from './AddSourceModal';\r\nimport DocumentViewerModal from './DocumentViewerModal'; \r\nimport ImageViewerModal from './ImageViewerModal';\r\nimport { KB_CATEGORIES } from '../constants';\r\nimport { \r\n    InfoCard, \r\n    CategoryCard, \r\n    SectionHeader, \r\n    M3Button \r\n} from './ui';\r\n\r\ninterface KnowledgeBaseProps {\r\n    knowledgeBase: KnowledgeBaseEntry[];\r\n    setKnowledgeBase: React.Dispatch<React.SetStateAction<KnowledgeBaseEntry[]>>;\r\n    corpora: Corpus[];\r\n    setCorpora: React.Dispatch<React.SetStateAction<Corpus[]>>;\r\n    aiSettings?: AiSettings;\r\n    showToast: (msg: string, type?: 'success' | 'error' | 'info') => void;\r\n    settings?: TimetableSettings;\r\n    showGuidanceTips?: boolean;\r\n}\r\n\r\nconst KnowledgeBase: React.FC<KnowledgeBaseProps> = ({ knowledgeBase, setKnowledgeBase, corpora, setCorpora, showToast }) => {\r\n    const [searchTerm, setSearchTerm] = useState('');\r\n    const [currentView, setCurrentView] = useState<{ type: 'root' | 'category' | 'corpus', id: string }>({ type: 'root', id: '' });\r\n    const [isAddSourceModalOpen, setIsAddSourceModalOpen] = useState(false);\r\n    const [previewingEntry, setPreviewingEntry] = useState<KnowledgeBaseEntry | null>(null);\r\n    const [viewingImage, setViewingImage] = useState<KnowledgeBaseEntry | null>(null);\r\n    // aiSettings, settings, showGuidanceTips sono ricevuti come props ma non usati attualmente\r\n\r\n    const handleDeleteFile = (fileId: string) => {\r\n        if (!window.confirm(`Sei sicuro di voler eliminare questo file?`)) return;\r\n        setKnowledgeBase(prev => prev.filter(entry => entry.id !== fileId));\r\n    };\r\n\r\n    const handleAddEntries = (newEntries: KnowledgeBaseEntry[]) => {\r\n        setKnowledgeBase(prev => [...prev, ...newEntries]);\r\n        showToast(`${newEntries.length} file aggiunti con successo!`, 'success');\r\n    };\r\n\r\n    const filteredFiles = useMemo(() => {\r\n        return knowledgeBase.filter(entry => {\r\n            const matchesSearch = entry.fileName.toLowerCase().includes(searchTerm.toLowerCase());\r\n            if (!matchesSearch) return false;\r\n            if (currentView.type === 'category') {\r\n                if (currentView.id === 'archivio') return entry.category === 'archivio' || !entry.category;\r\n                return entry.category === currentView.id;\r\n            }\r\n            if (currentView.type === 'corpus') return entry.corpusId === currentView.id;\r\n            return false; \r\n        }).sort((a, b) => a.fileName.localeCompare(b.fileName));\r\n    }, [knowledgeBase, searchTerm, currentView]);\r\n\r\n    const categoryCounts = useMemo(() => {\r\n        const counts: Record<string, number> = {};\r\n        KB_CATEGORIES.forEach(c => counts[c.id] = 0);\r\n        knowledgeBase.forEach(entry => {\r\n            const cat = entry.category || 'archivio';\r\n            const target = counts[cat] !== undefined ? cat : 'archivio';\r\n            counts[target] = (counts[target] || 0) + 1;\r\n        });\r\n        return counts;\r\n    }, [knowledgeBase]);\r\n\r\n    const handleFileClick = (entry: KnowledgeBaseEntry) => {\r\n        if (entry.fileContent?.mimeType.startsWith('image/')) setViewingImage(entry);\r\n        else setPreviewingEntry(entry);\r\n    };\r\n\r\n    const renderFolderDashboard = () => (\r\n        <div className=\"knowledge-base-folder-grid\">\r\n             {KB_CATEGORIES.map(cat => (\r\n                 <CategoryCard \r\n                    key={cat.id} \r\n                    id={cat.id}\r\n                    label={cat.label}\r\n                    icon={cat.icon}\r\n                    color={cat.color}\r\n                    isSelected={currentView.type === 'category' && currentView.id === cat.id}\r\n                    onClick={() => setCurrentView({ type: 'category', id: cat.id })}\r\n                    description={`${categoryCounts[cat.id] || 0} file salvati`}\r\n                />\r\n             ))}\r\n        </div>\r\n    );\r\n\r\n    const renderFileList = () => {\r\n        const categoryInfo = currentView.type === 'category' ? KB_CATEGORIES.find(c => c.id === currentView.id) : null;\r\n        return (\r\n            <div className=\"knowledge-base-file-list\">\r\n                <header className=\"knowledge-base-file-header\">\r\n                    <div className=\"knowledge-base-file-header-content\">\r\n                        <M3Button onClick={() => setCurrentView({ type: 'root', id: '' })} variant=\"text\" className=\"knowledge-base-back-button\">\r\n                            <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}}>arrow_back</span>\r\n                        </M3Button>\r\n                        <h2 className=\"knowledge-base-file-title\">{categoryInfo?.label || 'File'}</h2>\r\n                    </div>\r\n                    <div className=\"knowledge-base-search-container\">\r\n                        <span className=\"knowledge-base-search-icon\">search</span>\r\n                        <input \r\n                            type=\"text\" \r\n                            placeholder=\"Cerca in questa cartella...\" \r\n                            className=\"knowledge-base-search-input\" \r\n                            value={searchTerm} \r\n                            onChange={(e) => setSearchTerm(e.target.value)} \r\n                        />\r\n                    </div>\r\n                </header>\r\n\r\n                <div className=\"knowledge-base-file-grid\">\r\n                    {filteredFiles.map(entry => (\r\n                        <div \r\n                            key={entry.id} \r\n                            className=\"knowledge-base-file-card\"\r\n                            onClick={() => handleFileClick(entry)}\r\n                        >\r\n                            <div className=\"knowledge-base-file-icon\">\r\n                                <span className=\"material-symbols-outlined knowledge-base-file-icon-symbol\">\r\n                                    {entry.category === 'ai_deliverable' ? 'auto_awesome' : (entry.fileContent?.mimeType === 'application/pdf' ? 'picture_as_pdf' : 'description')}\r\n                                </span>\r\n                            </div>\r\n                            <div className=\"knowledge-base-file-info\">\r\n                                <p className=\"knowledge-base-file-name\">{entry.fileName}</p>\r\n                                <p className=\"knowledge-base-file-type\">\r\n                                    {entry.isGenerated ? 'Generato con AI' : 'Documento locale'}\r\n                                </p>\r\n                            </div>\r\n                            <M3Button \r\n                                onClick={(e) => { e.stopPropagation(); handleDeleteFile(entry.id); }} \r\n                                variant=\"text\" \r\n                                className=\"knowledge-base-file-delete\"\r\n                            >\r\n                                <span className=\"material-symbols-outlined knowledge-base-file-delete-icon\">delete</span>\r\n                            </M3Button>\r\n                        </div>\r\n                    ))}\r\n                    {filteredFiles.length === 0 && (\r\n                        <div className=\"knowledge-base-empty\">\r\n                            <span className=\"material-symbols-outlined knowledge-base-empty-icon\">search_off</span>\r\n                            <p className=\"knowledge-base-empty-text\">Nessun file trovato in questa cartella.</p>\r\n                        </div>\r\n                    )}\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    return (\r\n        <div className=\"page-layout pb-24\" style={{ maxWidth: \"100%\", marginLeft: \"auto\", marginRight: \"auto\", width: \"100%\", paddingLeft: \"var(--md-sys-spacing-4)\", paddingRight: \"var(--md-sys-spacing-4)\" }}>\r\n            <div className=\"md:flex-row md:items-center\" style={{ display: \"flex\", flexDirection: \"column\", justifyContent: \"space-between\", gap: \"var(--md-sys-spacing-8)\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                <SectionHeader \r\n                    title=\"Knowledge Base\" \r\n                    subtitle=\"Archivio fonti, documenti e deliverable generati dall'AI.\"\r\n                    icon=\"database\"\r\n                />\r\n                <M3Button onClick={() => setIsAddSourceModalOpen(true)} variant=\"filled\" className=\"shadow-[var(--md-sys-elevation-level2)] px-6 py-6 rounded-[var(--md-sys-shape-corner-large)]\" style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                    <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}}>add_circle</span>\r\n                    Carica Documenti\r\n                </M3Button>\r\n            </div>\r\n\r\n            <InfoCard \r\n                title=\"Sincronia NotebookLM\"\r\n                description=\"Puoi caricare qui le analisi o i progetti prodotti con NotebookLM. L'app li user├á come base di conoscenza prioritaria per generare le tue lezioni e UDA.\"\r\n                icon=\"bolt\"\r\n                variant=\"primary\"\r\n                className=\"bg-primary-container/20 border-primary/20\" style={{ marginBottom: \"var(--md-sys-spacing-8)\" }}\r\n            />\r\n\r\n            <main className=\"min-h-[500px]\">\r\n                {currentView.type === 'root' ? renderFolderDashboard() : renderFileList()}\r\n            </main>\r\n\r\n            {isAddSourceModalOpen && (\r\n                <AddSourceModal\r\n                    corpora={corpora}\r\n                    setCorpora={setCorpora}\r\n                    onClose={() => setIsAddSourceModalOpen(false)}\r\n                    onAddEntries={handleAddEntries}\r\n                />\r\n            )}\r\n            {previewingEntry && (\r\n                <DocumentViewerModal\r\n                    title={previewingEntry.fileName}\r\n                    htmlContent={previewingEntry.htmlContent || `<pre>${previewingEntry.content}</pre>`}\r\n                    onClose={() => setPreviewingEntry(null)}\r\n                />\r\n            )}\r\n            {viewingImage && (\r\n                 <ImageViewerModal\r\n                    prompt={viewingImage.content}\r\n                    imageData={viewingImage.fileContent!.data}\r\n                    mimeType={viewingImage.fileContent!.mimeType}\r\n                    onClose={() => setViewingImage(null)}\r\n                    onSaveToKb={() => {}}\r\n                />\r\n            )}\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default KnowledgeBase;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\LessonAnalysisModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":22,"column":30,"nodeType":"JSXAttribute","endLine":22,"endColumn":71},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":23,"column":22,"nodeType":"JSXAttribute","endLine":23,"endColumn":68},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":27,"column":26,"nodeType":"JSXAttribut