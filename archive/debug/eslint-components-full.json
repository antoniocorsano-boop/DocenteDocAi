tokens instead.","line":165,"column":21,"nodeType":"JSXAttribute","endLine":165,"endColumn":44},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":167,"column":22,"nodeType":"JSXAttribute","endLine":167,"endColumn":62},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'w-48' not allowed. Use MD3 tokens in inline styles.","line":167,"column":22,"nodeType":"JSXAttribute","endLine":167,"endColumn":62},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":180,"column":18,"nodeType":"JSXAttribute","endLine":180,"endColumn":49},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":188,"column":31,"nodeType":"JSXAttribute","endLine":188,"endColumn":51},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-4xl' not allowed. Use MD3 tokens in inline styles.","line":188,"column":31,"nodeType":"JSXAttribute","endLine":188,"endColumn":51},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":189,"column":28,"nodeType":"JSXAttribute","endLine":189,"endColumn":99},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":189,"column":28,"nodeType":"JSXAttribute","endLine":189,"endColumn":99},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":202,"column":31,"nodeType":"JSXAttribute","endLine":202,"endColumn":51},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-4xl' not allowed. Use MD3 tokens in inline styles.","line":202,"column":31,"nodeType":"JSXAttribute","endLine":202,"endColumn":51},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":215,"column":31,"nodeType":"JSXAttribute","endLine":215,"endColumn":51},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-4xl' not allowed. Use MD3 tokens in inline styles.","line":215,"column":31,"nodeType":"JSXAttribute","endLine":215,"endColumn":51},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":222,"column":18,"nodeType":"JSXAttribute","endLine":222,"endColumn":127},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[2.5rem]' not allowed. Use MD3 tokens in inline styles.","line":222,"column":18,"nodeType":"JSXAttribute","endLine":222,"endColumn":127},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-[var(--md-sys-color-outline-variant)]/20' not allowed. Use MD3 tokens in inline styles.","line":222,"column":18,"nodeType":"JSXAttribute","endLine":222,"endColumn":127},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":223,"column":22,"nodeType":"JSXAttribute","endLine":223,"endColumn":112},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-[var(--md-sys-color-outline-variant)]/10' not allowed. Use MD3 tokens in inline styles.","line":223,"column":22,"nodeType":"JSXAttribute","endLine":223,"endColumn":112},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-surface/30' not allowed. Use MD3 tokens in inline styles.","line":223,"column":22,"nodeType":"JSXAttribute","endLine":223,"endColumn":112},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":226,"column":25,"nodeType":"JSXAttribute","endLine":226,"endColumn":365},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":232,"column":25,"nodeType":"JSXAttribute","endLine":232,"endColumn":363}],"suppressedMessages":[],"errorCount":52,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState, useMemo } from 'react';\r\nimport { \r\n    Studente, \r\n    OrientamentoActivity, \r\n    EPortfolioEntry, \r\n    StudentOrientamentoState \r\n} from '../types';\r\nimport { \r\n    M3Button, \r\n    SectionHeader, \r\n    Avatar, \r\n    EmptyState, \r\n    InfoCard, \r\n    SelectField\r\n} from './ui';\r\nimport AddOrientamentoActivityModal from './AddOrientamentoActivityModal';\r\nimport StudentEPortfolioModal from './StudentEPortfolioModal';\r\n\r\ninterface OrientamentoDashboardProps {\r\n    students: Studente[];\r\n    activities: OrientamentoActivity[];\r\n    ePortfolioEntries: EPortfolioEntry[];\r\n    studentStates: Record<string, StudentOrientamentoState>;\r\n    userClasses: string[];\r\n    onSaveActivity: (activity: OrientamentoActivity) => void;\r\n    onSaveEPortfolio: (entry: EPortfolioEntry) => void;\r\n    onUpdateStudentState: (state: StudentOrientamentoState) => void;\r\n    showToast: (msg: string, type?: 'success' | 'error' | 'info') => void;\r\n}\r\n\r\nconst OrientamentoDashboard: React.FC<OrientamentoDashboardProps> = ({\r\n    students,\r\n    activities,\r\n    ePortfolioEntries,\r\n    studentStates,\r\n    userClasses,\r\n    onSaveActivity,\r\n    onSaveEPortfolio,\r\n    onUpdateStudentState,\r\n    showToast\r\n}) => {\r\n    const [selectedClass, setSelectedClass] = useState<string>(userClasses[0] || '');\r\n    const [activeTab, setActiveTab] = useState<'activities' | 'students'>('activities');\r\n    const [isAddActivityModalOpen, setIsAddActivityModalOpen] = useState(false);\r\n    const [viewingStudent, setViewingStudent] = useState<Studente | null>(null);\r\n\r\n    const filteredStudents = useMemo(() => {\r\n        return students.filter(s => s.classe === selectedClass);\r\n    }, [students, selectedClass]);\r\n\r\n    const filteredActivities = useMemo(() => {\r\n        return activities.filter(a => a.classes.includes(selectedClass));\r\n    }, [activities, selectedClass]);\r\n\r\n    const totalHours = useMemo(() => {\r\n        return filteredActivities.reduce((acc, curr) => acc + curr.durationHours, 0);\r\n    }, [filteredActivities]);\r\n\r\n    const renderActivitiesTab = () => (\r\n        <div style={{ gap: \"var(--md-sys-spacing-6)\" }}>\r\n            <div style={{ display: \"flex\", alignItems: \"center\", justifyContent: \"space-between\" }}>\r\n                <h3 className=\"m3-title-large text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"900\" }}>Attivit´┐¢ di Orientamento</h3>\r\n                <M3Button onClick={() => setIsAddActivityModalOpen(true)} variant=\"filled\">\r\n                    <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\" }}>add</span>\r\n                    Nuova Attivit´┐¢\r\n                </M3Button>\r\n            </div>\r\n\r\n            <div className=\"md:grid-cols-2 lg:grid-cols-3\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                {filteredActivities.map(activity => (\r\n                    <InfoCard \r\n                        key={activity.id}\r\n                        title={activity.title}\r\n                        description={`${activity.durationHours} ore ÔÇó ${new Date(activity.date).toLocaleDateString('it-IT')}`}\r\n                        icon=\"explore\"\r\n                        variant=\"surface\"\r\n                    >\r\n                        <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant line-clamp-2\" style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                            {activity.description}\r\n                        </p>\r\n                    </InfoCard>\r\n                ))}\r\n                {filteredActivities.length === 0 && (\r\n                    <div className=\"col-span-full\">\r\n                        <EmptyState \r\n                            title=\"Nessuna attivit├á\" \r\n                            description=\"Inizia aggiungendo un'attivit├á di orientamento per questa classe.\" \r\n                            icon=\"explore_off\" \r\n                        />\r\n                    </div>\r\n                )}\r\n            </div>\r\n        </div>\r\n    );\r\n\r\n    const renderStudentsTab = () => (\r\n        <div style={{ gap: \"var(--md-sys-spacing-6)\" }}>\r\n            <h3 className=\"m3-title-large text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"900\" }}>Stato E-Portfolio Studenti</h3>\r\n            <div className=\"aura-glass overflow-hidden border-[var(--md-sys-color-outline-variant)]/20\" style={{ border: \"1px solid var(--md-sys-color-outline)\" }}>\r\n                <table className=\"border-collapse\" style={{ width: \"100%\" }}>\r\n                    <thead>\r\n                        <tr className=\"bg-[var(--md-sys-color-surface-container-low)]/50\">\r\n                            <th className=\"m3-label-large\" style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"left\", color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Studente</th>\r\n                            <th className=\"m3-label-large\" style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"center\", color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Ore Totali</th>\r\n                            <th className=\"m3-label-large\" style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"center\", color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Capolavoro</th>\r\n                            <th className=\"m3-label-large\" style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"center\", color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Autovalutazione</th>\r\n                            <th className=\"m3-label-large\" style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"right\", color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Azioni</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody className=\"divide-y divide-outline-variant/10\">\r\n                        {filteredStudents.map(student => {\r\n                            const state = studentStates[student.id] || { studentId: student.id, totalHours: 0, hasCapolavoro: false, hasAutovalutazione: false };\r\n                            const progress = Math.min(100, (totalHours / 30) * 100); // Using class total hours as per guidelines for class activities\r\n                            \r\n                            return (\r\n                                <tr key={student.id} className=\"hover:bg-primary/5\" style={{ transition: \"color 300ms\" }}>\r\n                                    <td style={{ padding: 'var(--md-sys-spacing-6)' }}>\r\n                                        <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                                            <Avatar name={`${student.nome} ${student.cognome}`} size=\"sm\" />\r\n                                            <span className=\"text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"bold\" }}>{student.cognome} {student.nome}</span>\r\n                                        </div>\r\n                                    </td>\r\n                                    <td style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"center\" }}>\r\n                                        <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", gap: \"var(--md-sys-spacing-4)\" }}>\r\n                                            <span style={{ fontWeight: \"900\", color: \"var(--md-sys-color-primary)\" }}>{totalHours}/30h</span>\r\n                                            <div className=\"h-1.5 bg-[var(--md-sys-color-surface-container-high)]est overflow-hidden\" style={{ width: \"6rem\", borderRadius: \"9999px\" }}>\r\n                                                <div \r\n                                                    className={`h-full transition-all ${progress >= 100 ? 'bg-tertiary' : 'bg-primary'}`}\r\n                                                    style={{ width: `${progress}%` }}\r\n                                                ></div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </td>\r\n                                    <td style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"center\" }}>\r\n                                        <span className={`material-symbols-outlined ${state.hasCapolavoro ? 'text-tertiary' : 'text-[var(--md-sys-color-on-surface)]-variant/20'}`}>\r\n                                            {state.hasCapolavoro ? 'check_circle' : 'radio_button_unchecked'}\r\n                                        </span>\r\n                                    </td>\r\n                                    <td style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"center\" }}>\r\n                                        <span className={`material-symbols-outlined ${state.hasAutovalutazione ? 'text-tertiary' : 'text-[var(--md-sys-color-on-surface)]-variant/20'}`}>\r\n                                            {state.hasAutovalutazione ? 'check_circle' : 'radio_button_unchecked'}\r\n                                        </span>\r\n                                    </td>\r\n                                    <td style={{ padding: \"var(--md-sys-spacing-8)\", textAlign: \"right\" }}>\r\n                                        <M3Button onClick={() => setViewingStudent(student)} variant=\"text\">\r\n                                            Dettagli\r\n                                        </M3Button>\r\n                                    </td>\r\n                                </tr>\r\n                            );\r\n                        })}\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n    );\r\n\r\n    return (\r\n        <div className=\"page-layout px-6 pb-32\">\r\n            <div className=\"md:flex-row md:items-center\" style={{ display: \"flex\", flexDirection: \"column\", justifyContent: \"space-between\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                <SectionHeader \r\n                    title=\"Orientamento & E-Portfolio\"\r\n                    subtitle=\"Monitoraggio delle 30 ore annuali e gestione documenti istituzionali (Linee Guida 2023).\"\r\n                    className=\"!mb-0 !mt-0\" style={{ flexGrow: \"1\" }}\r\n                />\r\n                <div className=\"w-48 self-end md:self-center\">\r\n                    <SelectField \r\n                        label=\"Classe\"\r\n                        value={selectedClass}\r\n                        onChange={e => setSelectedClass(e.target.value)}\r\n                    >\r\n                        {userClasses.map(c => (\r\n                            <option key={c} value={c}>Classe {c}</option>\r\n                        ))}\r\n                    </SelectField>\r\n                </div>\r\n            </div>\r\n\r\n            <div className=\"lg:grid-cols-3 mt-8\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                <InfoCard \r\n                    title=\"Ore Medie Classe\" \r\n                    description=\"Target Ministeriale: 30h\"\r\n                    icon=\"schedule\"\r\n                    variant=\"primary\"\r\n                >\r\n                    <div style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                        <span className=\"text-4xl\" style={{ fontWeight: \"900\", color: \"var(--md-sys-color-primary)\" }}>{totalHours}h</span>\r\n                        <p className=\"m3-body-small text-[var(--md-sys-color-on-surface)]-variant\" style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                            {totalHours >= 30 ? 'Ô£à Target raggiunto per la classe' : `Mancano ${30 - totalHours}h al target`}\r\n                        </p>\r\n                    </div>\r\n                </InfoCard>\r\n\r\n                <InfoCard \r\n                    title=\"Completamento E-Portfolio\" \r\n                    description=\"Studenti con Capolavoro\"\r\n                    icon=\"auto_awesome\"\r\n                    variant=\"tertiary\"\r\n                >\r\n                    <div style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                        <span className=\"text-4xl\" style={{ fontWeight: \"900\", color: \"var(--md-sys-color-tertiary)\" }}>\r\n                            {filteredStudents.filter(s => studentStates[s.id]?.hasCapolavoro).length}/{filteredStudents.length}\r\n                        </span>\r\n                    </div>\r\n                </InfoCard>\r\n\r\n                <InfoCard \r\n                    title=\"Autovalutazioni\" \r\n                    description=\"Riflessioni caricate\"\r\n                    icon=\"psychology\"\r\n                    variant=\"secondary\"\r\n                >\r\n                    <div style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                        <span className=\"text-4xl\" style={{ fontWeight: \"900\", color: \"var(--md-sys-color-secondary)\" }}>\r\n                            {filteredStudents.filter(s => studentStates[s.id]?.hasAutovalutazione).length}/{filteredStudents.length}\r\n                        </span>\r\n                    </div>\r\n                </InfoCard>\r\n            </div>\r\n\r\n            <div className=\"mt-12 aura-glass rounded-[2.5rem] overflow-hidden border-[var(--md-sys-color-outline-variant)]/20\" style={{ border: \"1px solid var(--md-sys-color-outline)\" }}>\r\n                <div className=\"border-[var(--md-sys-color-outline-variant)]/10 bg-surface/30 backdrop-blur-md\" style={{ display: \"flex\", borderBottom: \"1px solid var(--md-sys-color-outline)\", padding: \"var(--md-sys-spacing-8)\" }}>\r\n                    <button \r\n                        onClick={() => setActiveTab('activities')}\r\n                        className={`flex-grow py-4 font-black text-[10px] uppercase tracking-widest transition-all rounded-[var(--md-sys-shape-corner-large)] ${activeTab === 'activities' ? 'bg-primary text-on-primary shadow-[var(--md-sys-elevation-level2)]' : 'text-[var(--md-sys-color-on-surface)]-variant hover:bg-[var(--md-sys-color-surface-container-high)]'}`}\r\n                    >\r\n                        Attivit´┐¢ di Orientamento\r\n                    </button>\r\n                    <button \r\n                        onClick={() => setActiveTab('students')}\r\n                        className={`flex-grow py-4 font-black text-[10px] uppercase tracking-widest transition-all rounded-[var(--md-sys-shape-corner-large)] ${activeTab === 'students' ? 'bg-primary text-on-primary shadow-[var(--md-sys-elevation-level2)]' : 'text-[var(--md-sys-color-on-surface)]-variant hover:bg-[var(--md-sys-color-surface-container-high)]'}`}\r\n                    >\r\n                        Stato Studenti\r\n                    </button>\r\n                </div>\r\n\r\n                <div style={{ padding: 'var(--md-sys-spacing-6)' }}>\r\n                    {activeTab === 'activities' ? renderActivitiesTab() : renderStudentsTab()}\r\n                </div>\r\n            </div>\r\n\r\n            {/* Modals */}\r\n            <AddOrientamentoActivityModal\r\n                isOpen={isAddActivityModalOpen}\r\n                onClose={() => setIsAddActivityModalOpen(false)}\r\n                onSave={(a) => {\r\n                    onSaveActivity(a);\r\n                    showToast('Attivit├á salvata con successo', 'success');\r\n                }}\r\n                userClasses={userClasses}\r\n            />\r\n\r\n            {viewingStudent && (\r\n                <StudentEPortfolioModal\r\n                    isOpen={!!viewingStudent}\r\n                    onClose={() => setViewingStudent(null)}\r\n                    student={viewingStudent}\r\n                    state={studentStates[viewingStudent.id] || { studentId: viewingStudent.id, hasCapolavoro: false, hasAutovalutazione: false, totalHours: 0, activities: [], ePortfolio: [], selfReflection: '', tutorNotes: '' }}\r\n                    entries={ePortfolioEntries.filter(e => e.studentId === viewingStudent.id)}\r\n                    onUpdateState={onUpdateStudentState}\r\n                    onAddEntry={(e) => {\r\n                        onSaveEPortfolio(e);\r\n                        showToast('Documento aggiunto all\\'E-Portfolio', 'success');\r\n                    }}\r\n                />\r\n            )}\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default OrientamentoDashboard;\r\n\r\n\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ParticipationBadgePicker.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":37,"column":31,"nodeType":"JSXAttribute","endLine":37,"endColumn":93},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":38,"column":16,"nodeType":"JSXAttribute","endLine":38,"endColumn":60},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":39,"column":18,"nodeType":"JSXAttribute","endLine":39,"endColumn":61},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":43,"column":25,"nodeType":"JSXAttribute","endLine":43,"endColumn":70},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":49,"column":31,"nodeType":"JSXAttribute","endLine":49,"endColumn":75}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\n/* M3Expressive - ParticipationBadgePicker Component */\r\n\r\nimport React, { useEffect, useRef } from 'react';\r\nimport { ParticipationBadge } from '../types';\r\nimport { PARTICIPATION_BADGES } from '../constants';\r\n\r\ninterface ParticipationBadgePickerProps {\r\n    anchorEl: HTMLElement | null;\r\n    onSelect: (badgeId: ParticipationBadge['id']) => void;\r\n    onClose: () => void;\r\n}\r\n\r\nconst ParticipationBadgePicker: React.FC<ParticipationBadgePickerProps> = ({ anchorEl, onSelect, onClose }) => {\r\n    const popoverRef = useRef<HTMLDivElement>(null);\r\n\r\n    useEffect(() => {\r\n        const handleClickOutside = (event: MouseEvent) => {\r\n            if (popoverRef.current && !popoverRef.current.contains(event.target as Node)) {\r\n                onClose();\r\n            }\r\n        };\r\n        document.addEventListener('mousedown', handleClickOutside);\r\n        return () => document.removeEventListener('mousedown', handleClickOutside);\r\n    }, [onClose]);\r\n\r\n    const style: React.CSSProperties = {};\r\n    if (anchorEl) {\r\n        const rect = anchorEl.getBoundingClientRect();\r\n        style.position = 'fixed';\r\n        style.top = `${rect.bottom + 8}px`;\r\n        const leftPos = Math.min(window.innerWidth - 300, Math.max(16, rect.left - 100));\r\n        style.left = `${leftPos}px`;\r\n    }\r\n\r\n    return (\r\n        <div ref={popoverRef} className=\"participation-badge-picker-container m3-popup-menu\" style={style}>\r\n            <p className=\"participation-badge-picker-title\">Assegna Badge</p>\r\n            <div className=\"participation-badge-picker-grid\">\r\n                {PARTICIPATION_BADGES.map(badge => (\r\n                    <button \r\n                        key={badge.id}\r\n                        className=\"participation-badge-picker-button\"\r\n                        onClick={() => onSelect(badge.id)}\r\n                    >\r\n                        <span className=\"participation-badge-picker-icon material-symbols-outlined\" style={{ color: badge.color }}>\r\n                            {badge.icon}\r\n                        </span>\r\n                        <span className=\"participation-badge-picker-label\">{badge.label}</span>\r\n                    </button>\r\n                ))}\r\n            </div>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default ParticipationBadgePicker;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\PassaggioAnnoWizard.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":180,"column":30,"nodeType":"JSXAttribute","endLine":180,"endColumn":108},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message