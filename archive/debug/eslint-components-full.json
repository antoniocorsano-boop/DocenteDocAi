nline styles.","line":234,"column":34,"nodeType":"JSXAttribute","endLine":234,"endColumn":108},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'p-12' not allowed. Use MD3 tokens in inline styles.","line":234,"column":34,"nodeType":"JSXAttribute","endLine":234,"endColumn":108},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-4xl' not allowed. Use MD3 tokens in inline styles.","line":234,"column":34,"nodeType":"JSXAttribute","endLine":234,"endColumn":108},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-secondary/20' not allowed. Use MD3 tokens in inline styles.","line":234,"column":34,"nodeType":"JSXAttribute","endLine":234,"endColumn":108},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":235,"column":40,"nodeType":"JSXAttribute","endLine":235,"endColumn":134},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":235,"column":40,"nodeType":"JSXAttribute","endLine":235,"endColumn":134},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":236,"column":38,"nodeType":"JSXAttribute","endLine":236,"endColumn":56},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'gap-12' not allowed. Use MD3 tokens in inline styles.","line":236,"column":38,"nodeType":"JSXAttribute","endLine":236,"endColumn":56},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":242,"column":45,"nodeType":"JSXAttribute","endLine":242,"endColumn":187},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":245,"column":51,"nodeType":"JSXAttribute","endLine":245,"endColumn":77},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":253,"column":34,"nodeType":"JSXAttribute","endLine":253,"endColumn":51},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":254,"column":40,"nodeType":"JSXAttribute","endLine":254,"endColumn":94},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":260,"column":37,"nodeType":"JSXAttribute","endLine":260,"endColumn":157},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-small)]' not allowed. Use MD3 tokens in inline styles.","line":260,"column":37,"nodeType":"JSXAttribute","endLine":260,"endColumn":157},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":282,"column":38,"nodeType":"JSXAttribute","endLine":282,"endColumn":68},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'gap-12' not allowed. Use MD3 tokens in inline styles.","line":282,"column":38,"nodeType":"JSXAttribute","endLine":282,"endColumn":68},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":284,"column":66,"nodeType":"JSXAttribute","endLine":284,"endColumn":124},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level3)]' not allowed. Use MD3 tokens in inline styles.","line":284,"column":66,"nodeType":"JSXAttribute","endLine":284,"endColumn":124},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":303,"column":28,"nodeType":"JSXAttribute","endLine":303,"endColumn":85},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":305,"column":54,"nodeType":"JSXAttribute","endLine":305,"endColumn":137},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level1)]' not allowed. Use MD3 tokens in inline styles.","line":305,"column":54,"nodeType":"JSXAttribute","endLine":305,"endColumn":137},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":306,"column":42,"nodeType":"JSXAttribute","endLine":306,"endColumn":123},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":307,"column":43,"nodeType":"JSXAttribute","endLine":307,"endColumn":108},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]' not allowed. Use MD3 tokens in inline styles.","line":307,"column":43,"nodeType":"JSXAttribute","endLine":307,"endColumn":108},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":308,"column":43,"nodeType":"JSXAttribute","endLine":308,"endColumn":126},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":316,"column":45,"nodeType":"JSXAttribute","endLine":316,"endColumn":159},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-medium)]' not allowed. Use MD3 tokens in inline styles.","line":316,"column":45,"nodeType":"JSXAttribute","endLine":316,"endColumn":159},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":319,"column":51,"nodeType":"JSXAttribute","endLine":319,"endColumn":100},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]' not allowed. Use MD3 tokens in inline styles.","line":319,"column":51,"nodeType":"JSXAttribute","endLine":319,"endColumn":100},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":328,"column":114,"nodeType":"JSXAttribute","endLine":328,"endColumn":165},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level2)]' not allowed. Use MD3 tokens in inline styles.","line":328,"column":114,"nodeType":"JSXAttribute","endLine":328,"endColumn":165}],"suppressedMessages":[],"errorCount":40,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useMemo } from 'react';\r\nimport { Lezione, AiSettings, Studente, PianoInclusione, Slot, CurriculumSubject } from '../types';\r\nimport { generateInclusivityAdaptations } from '../services/aiService';\r\nimport { DAYS_OF_WEEK } from '../constants';\r\nimport { parseClassString } from '../utils/schoolUtils'; \r\nimport { TextField, SelectField, TextArea, M3Dialog, M3DialogContent, M3DialogActions, M3Button, AiThinkingGem } from './ui';\r\n\r\ninterface CreateLessonFromAiModalProps {\r\n    content: { title: string; htmlContent: string };\r\n    onClose: () => void;\r\n    onSave: (lessonData: Omit<Lezione, 'id' | 'svolta'>) => void;\r\n    userClasses: string[];\r\n    disciplines: string[];\r\n    students: Studente[];\r\n    pianiInclusione: Record<string, PianoInclusione>;\r\n    aiSettings: AiSettings;\r\n    slots?: Record<string, Slot>;\r\n    onSchedule?: (lesson: Lezione, slotKey: string) => void;\r\n    curricula: CurriculumSubject[]; \r\n}\r\n\r\nconst CreateLessonFromAiModal: React.FC<CreateLessonFromAiModalProps> = ({ content, onClose, onSave, userClasses, disciplines, students, pianiInclusione, aiSettings, slots, onSchedule, curricula }) => {\r\n    const [argomento, setArgomento] = useState('');\r\n    const [obiettivi, setObiettivi] = useState('');\r\n    const [classe, setClasse] = useState(userClasses[0] || '');\r\n    const [materia, setMateria] = useState(disciplines[0] || '');\r\n    const [adattamenti, setAdattamenti] = useState('');\r\n    const [isAdaptationsLoading, setIsAdaptationsLoading] = useState(false);\r\n    const [selectedSlotKey, setSelectedSlotKey] = useState<string>('');\r\n    \r\n    // Objective Picker State\r\n    const [isObjectivePickerOpen, setIsObjectivePickerOpen] = useState(false);\r\n\r\n    useEffect(() => {\r\n        // AI-powered pre-fill\r\n        setArgomento(content.title);\r\n\r\n        const tempDiv = document.createElement('div');\r\n        tempDiv.innerHTML = content.htmlContent;\r\n        \r\n        let extractedObjectives = '';\r\n        // Try to find a list, which is a good candidate for objectives\r\n        const list = tempDiv.querySelector('ul, ol');\r\n        if (list) {\r\n            extractedObjectives = Array.from(list.querySelectorAll('li'))\r\n                .map(li => `- ${li.textContent?.trim()}`)\r\n                .join('\\n');\r\n        } else {\r\n            // Fallback: take the first few lines of text\r\n            extractedObjectives = (tempDiv.textContent || '')\r\n                .split('\\n')\r\n                .filter(line => line.trim().length > 10) // Filter out short/empty lines\r\n                .slice(0, 3)\r\n                .map(line => `- ${line.trim()}`)\r\n                .join('\\n');\r\n        }\r\n        setObiettivi(extractedObjectives);\r\n\r\n    }, [content]);\r\n\r\n    // Find free slots for the selected class\r\n    const availableSlots = useMemo(() => {\r\n        if (!slots || !classe) return [];\r\n        // FIX: Casting esplicito di entries per TS\r\n        const entries = Object.entries(slots) as [string, Slot][];\r\n        return entries\r\n            .filter(([, slot]) => !slot.lezioneId && (!slot.classe || slot.classe === classe)) // Filter out already assigned slots\r\n            .sort((a: [string, Slot], b: [string, Slot]) => {\r\n                const dayOrder = DAYS_OF_WEEK.indexOf(a[1].giorno) - DAYS_OF_WEEK.indexOf(b[1].giorno);\r\n                if (dayOrder !== 0) return dayOrder;\r\n                return a[1].ora.localeCompare(b[1].ora);\r\n            })\r\n            .slice(0, 4); // Show only a few for quick selection\r\n    }, [slots, classe]);\r\n\r\n    // Logic to find matching curriculum\r\n    const matchingCurriculum = useMemo(() => {\r\n        if (!classe || !materia || !curricula) return null;\r\n        \r\n        // 1. Try exact match on subject\r\n        const subjectMatch = curricula.filter(c => c.subject === materia);\r\n        if (subjectMatch.length === 0) return null;\r\n\r\n        // 2. Try to match grade level (e.g. \"1A\" -> \"1\" or \"Prime\")\r\n        const parsed = parseClassString(classe);\r\n        if (!parsed) return subjectMatch[0]; // Fallback to first\r\n\r\n        // Fuzzy match grade level string\r\n        return subjectMatch.find(c => {\r\n            const gradeStr = parsed.grade.toString();\r\n            return c.gradeLevel.includes(gradeStr) || \r\n                   (parsed.grade === 1 && c.gradeLevel.toLowerCase().includes('prime')) ||\r\n                   (parsed.grade === 2 && c.gradeLevel.toLowerCase().includes('seconde')) ||\r\n                   (parsed.grade === 3 && c.gradeLevel.toLowerCase().includes('terze')) ||\r\n                   (parsed.grade === 4 && c.gradeLevel.toLowerCase().includes('quarte')) ||\r\n                   (parsed.grade === 5 && c.gradeLevel.toLowerCase().includes('quinte'));\r\n        }) || subjectMatch[0];\r\n\r\n    }, [curricula, classe, materia]);\r\n\r\n    const handleAddObjective = (text: string) => {\r\n        setObiettivi(prev => {\r\n            const prefix = prev.trim() ? '\\n' : '';\r\n            return `${prev}${prefix}- ${text}`;\r\n        });\r\n    };\r\n\r\n    const handleSubmit = (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        if (!argomento.trim() || !classe || !materia) {\r\n            alert('Per favore, compila Argomento, Classe e Materia.');\r\n            return;\r\n        }\r\n        \r\n        const lessonData: Omit<Lezione, 'id' | 'svolta'> = {\r\n            contenuto: argomento,\r\n            obiettivi,\r\n            classe,\r\n            materia,\r\n            adattamenti,\r\n            tipoLezione: 'Teoria', // Default type\r\n            compiti: '',\r\n        };\r\n\r\n        if (selectedSlotKey && onSchedule) {\r\n            const fullLesson: Lezione = {\r\n                ...lessonData,\r\n                id: `lesson-ai-${Date.now()}`,\r\n                svolta: false\r\n            };\r\n            onSchedule(fullLesson, selectedSlotKey);\r\n        } else {\r\n            onSave(lessonData);\r\n        }\r\n        onClose();\r\n    };\r\n\r\n    const handleGenerateAdaptations = async () => {\r\n        if (!classe || !argomento) {\r\n            alert(\"Definisci la classe e l'argomento della lezione prima di chiedere suggerimenti.\");\r\n            return;\r\n        }\r\n    \r\n        setIsAdaptationsLoading(true);\r\n        try {\r\n            const pianiInclusionePerClasse = (Object.values(pianiInclusione) as PianoInclusione[]).filter(p => {\r\n                const student = students.find(s => s.id === p.id);\r\n                return student && student.classe === classe;\r\n            });\r\n    \r\n            if (pianiInclusionePerClasse.length === 0) {\r\n                alert(\"Nessun Piano di Inclusione attivo trovato per questa classe. Aggiungine uno dalla sezione 'Didattica Inclusiva' per ricevere suggerimenti mirati.\");\r\n                return; \r\n            }\r\n    \r\n            const lessonContext = {\r\n                contenuto: argomento,\r\n                classe: classe,\r\n            };\r\n    \r\n            const adaptations = await generateInclusivityAdaptations(aiSettings, lessonContext, pianiInclusionePerClasse);\r\n            \r\n            setAdattamenti(prev => prev ? `${prev}\\n${adaptations}` : adaptations);\r\n    \r\n        } catch (error) {\r\n            const errorMsg = error instanceof Error ? error.message : 'Errore sconosciuto';\r\n            console.error(\"Error generating inclusivity adaptations:\", errorMsg);\r\n            alert(\"Si ├¿ verificato un errore durante la generazione dei suggerimenti per l'inclusivit├á.\");\r\n        } finally {\r\n            setIsAdaptationsLoading(false);\r\n        }\r\n    };\r\n\r\n\r\n    return (\r\n        <>\r\n            <M3Dialog\r\n                title=\"Crea Bozza Lezione\"\r\n                onClose={onClose}\r\n                maxWidth=\"lg\"\r\n                level={1}\r\n            >\r\n                <form id=\"create-lesson-ai-form\" onSubmit={handleSubmit} style={{ width: \"100%\" }}>\r\n                    <M3DialogContent className=\"space-y-12 px-12 pt-12 pb-0\">\r\n                        <TextField \r\n                            label=\"Argomento\" \r\n                            value={argomento} \r\n                            onChange={e => setArgomento(e.target.value)} \r\n                            required \r\n                        />\r\n                        \r\n                        <div className=\"gap-12\" style={{ display: \"grid\", gridTemplateColumns: \"1fr 1fr\" }}>\r\n                            <SelectField label=\"Classe\" value={classe} onChange={e => setClasse(e.target.value)} required>\r\n                                {userClasses.map(c => <option key={c} value={c}>{c}</option>)}\r\n                            </SelectField>\r\n                            <SelectField label=\"Materia\" value={materia} onChange={e => setMateria(e.target.value)} required>\r\n                                {disciplines.map(d => <option key={d} value={d}>{d}</option>)}\r\n                            </SelectField>\r\n                        </div>\r\n\r\n                        <div>\r\n                            <div className=\"mb-12\" style={{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\" }}>\r\n                                <label className=\"m3-label-small font-extrabold tracking-[0.2em] px-8 !mb-0\" style={{ color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\" }}>Obiettivi</label>\r\n                                {matchingCurriculum && (\r\n                                    <M3Button \r\n                                        type=\"button\" \r\n                                        onClick={() => setIsObjectivePickerOpen(true)}\r\n                                        variant=\"tonal\"\r\n                                        className=\"!h-10 !px-6 !text-xs font-extrabold\" style={{ textTransform: \"uppercase\", letterSpacing: \"0.1em\", borderRadius: \"9999px\" }}\r\n                                        title=\"Seleziona dal curricolo\"\r\n                                    >\r\n                                        <span className=\"material-symbols-outlined mr-1\" style={{ fontSize: \"0.875rem\" }}>library_add</span>\r\n                                        Curricolo\r\n                                    </M3Button>\r\n                                )}\r\n                            </div>\r\n                            <TextArea\r\n                                label=\"Elenco obiettivi didattici per la lezione...\"\r\n                                value={obiettivi}\r\n                                onChange={e => setObiettivi(e.target.value)}\r\n                                rows={5}\r\n                                placeholder=\"Elenco obiettivi didattici per la lezione...\"\r\n                                containerClassName=\"shadow-inner !bg-[var(--md-sys-color-surface-container-low)]est\"\r\n                            />\r\n                            {matchingCurriculum && !obiettivi && (\r\n                                <p className=\"px-8\" style={{ fontSize: \"0.75rem\", color: \"var(--md-sys-color-primary)\", marginTop: \"var(--md-sys-spacing-4)\", display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\", fontWeight: \"bold\", cursor: \"pointer\" }} onClick={() => setIsObjectivePickerOpen(true)}>\r\n                                    <span className=\"material-symbols-outlined\" style={{ fontSize: \"0.875rem\" }}>info</span> \r\n                                    Curricolo disponibile: {matchingCurriculum.gradeLevel} di {matchingCurriculum.subject}\r\n                                </p>\r\n                            )}\r\n                        </div>\r\n                        \r\n                        {slots && availableSlots.length > 0 && (\r\n                            <div className=\"bg-secondary-container/10 p-12 rounded-4xl border-secondary/20\" style={{ border: \"1px solid var(--md-sys-color-outline)\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                                <label className=\"m3-label-small text-[var(--md-sys-color-on-surface)]-variant tracking-[0.2em] px-8\" style={{ fontWeight: \"900\", textTransform: \"uppercase\" }}>Pianificazione Rapida (Opzionale)</label>\r\n                                <div className=\"gap-12\" style={{ display: \"flex\", flexWrap: \"wrap\" }}>\r\n                                    {availableSlots.map(([key, slot]) => (\r\n                                        <button\r\n                                            key={key}\r\n                                            type=\"button\"\r\n                                            onClick={() => setSelectedSlotKey(prev => prev === key ? '' : key)}\r\n                                            className={`chip !h-12 !px-8 ${selectedSlotKey === key ? 'chip-selected border-primary' : 'bg-[var(--md-sys-color-surface-container-high)]'}`}\r\n                                        >\r\n                                            {selectedSlotKey === key && <span className=\"material-symbols-outlined\" style={{ fontSize: \"1rem\" }}>check</span>}\r\n                                            <span className=\"font-extrabold\" style={{ fontSize: \"0.75rem\" }}>{slot.giorno} {slot.ora}</span>\r\n                                        </button>\r\n                                    ))}\r\n                                </div>\r\n                            </div>\r\n                        )}\r\n\r\n                        <div>\r\n                            <div className=\"mb-12\" style={{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\" }}>\r\n                                <label className=\"m3-label-small tracking-[0.2em] px-8 !mb-0\" style={{ color: \"var(--md-sys-color-primary)\", fontWeight: \"900\", textTransform: \"uppercase\" }}>Adattamenti per l'Inclusivit├á</label>\r\n                                <M3Button \r\n                                    type=\"button\" \r\n                                    onClick={handleGenerateAdaptations} \r\n                                    disabled={isAdaptationsLoading} \r\n                                    variant=\"text\"\r\n                                    className=\"!h-auto !py-2 !px-8 rounded-[var(--md-sys-shape-corner-small)] hover:shadow-[var(--md-sys-elevation-level1)]\" style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\", fontWeight: \"900\", textTransform: \"uppercase\", fontSize: \"0.75rem\", transition: \"all 300ms cubic-bezier(0.4, 0, 0.2, 1)\" }}\r\n                                    title=\"Usa l'AI per suggerire adattamenti basati sui Piani di Inclusione della classe\"\r\n                                >\r\n                                    {isAdaptationsLoading ? (\r\n                                        <AiThinkingGem size=\"small\" inline text=\"Suggerisco...\" />\r\n                                    ) : (\r\n                                        <span className=\"material-symbols-outlined mr-1\" style={{ fontSize: \"1rem\" }}>auto_awesome</span>\r\n                                    )}\r\n                                    {isAdaptationsLoading ? '' : 'Suggerisci con AI'}\r\n                                </M3Button>\r\n                            </div>\r\n                            <TextArea \r\n                                label=\"Es. Fornire mappe concettuali, consentire l'uso della calcolatrice...\"\r\n                                value={adattamenti} \r\n                                onChange={(e) => setAdattamenti(e.target.value)} \r\n                                rows={4}\r\n                                placeholder=\"Es. Fornire mappe concettuali, consentire l'uso della calcolatrice...\"\r\n                                containerClassName=\"shadow-inner !bg-[var(--md-sys-color-surface-container-low)]est\"\r\n                            ></TextArea>\r\n                        </div>\r\n                    </M3DialogContent>\r\n\r\n                    <M3DialogActions className=\"gap-12 px-12 pb-12\" style={{ paddingTop: \"0\" }}>\r\n                        <M3Button type=\"button\" onClick={onClose} variant=\"text\">Annulla</M3Button>\r\n                        <M3Button type=\"submit\" variant=\"filled\" className=\"shadow-[var(--md-sys-elevation-level3)] !px-16\">\r\n                            <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\", fontWeight: \"900\" }}>{selectedSlotKey ? 'event_available' : 'archive'}</span>\r\n                            {selectedSlotKey ? 'Salva e Pianifica' : 'Salva in Archivio'}\r\n                        </M3Button>\r\n                    </M3DialogActions>\r\n                </form>\r\n            </M3Dialog>\r\n\r\n            {/* NESTED OBJECTIVE PICKER MODAL */}\r\n            {isObjectivePickerOpen && matchingCurriculum && (\r\n                <M3Dialog\r\n                    title=\"Seleziona Obiettivi\"\r\n                    onClose={() => setIsObjectivePickerOpen(false)}\r\n                    maxWidth=\"2xl\"\r\n                    level={2}\r\n                >\r\n                    <M3DialogContent style={{\r\n  marginTop: 'var(--md-sys-spacing-8)'\r\n}}>\r\n                        <p className=\"m3-label-tiny font-extrabold tracking-[0.3em]\" style={{ color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\" }}>{matchingCurriculum.subject} - {matchingCurriculum.gradeLevel}</p>\r\n                        {matchingCurriculum.nuclei.map(nucleo => (\r\n                            <details key={nucleo.id} className=\"m3-expansion-panel shadow-[var(--md-sys-elevation-level1)] !rounded-4xl\" open>\r\n                                <summary className=\"m3-expansion-summary !bg-[var(--md-sys-color-surface-container-high)]\">\r\n                                    <span className=\"m3-title-medium text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"900\" }}>{nucleo.title}</span>\r\n                                    <span className=\"material-symbols-outlined text-[var(--md-sys-color-on-surface)]-variant\" style={{ fontSize: \"0.875rem\" }}>expand_more</span>\r\n                                </summary>\r\n                                <div style={{ padding: \"var(--md-sys-spacing-8)\", gap: \"var(--md-sys-spacing-3)\", backgroundColor: \"var(--md-sys-color-surface)\" }}>\r\n                                    {nucleo.objectives.map(obj => (\r\n                                        <button \r\n                                            key={obj.id}\r\n                                            type=\"button\"\r\n                                            onClick={() => handleAddObjective(obj.text)}\r\n                                            className=\"rounded-[var(--md-sys-shape-corner-medium)] hover:bg-[var(--md-sys-color-surface-container-low)] group\" style={{ width: \"100%\", textAlign: \"left\", padding: \"var(--md-sys-spacing-6)\", transition: \"color 300ms\", display: \"flex\", alignItems: \"flex-start\", gap: \"var(--md-sys-spacing-6)\" }}\r\n                                        >\r\n                                            <span className=\"material-symbols-outlined mt-0.5 group-hover:scale-110\" style={{ color: \"var(--md-sys-color-primary)\", fontSize: \"1rem\", transition: \"transform 300ms\" }}>add_circle</span>\r\n                                            <span className=\"text-[var(--md-sys-color-on-surface)]\" style={{ fontSize: \"0.875rem\", fontWeight: \"500\" }}>{obj.text}</span>\r\n                                        </button>\r\n                                    ))}\r\n                                </div>\r\n                            </details>\r\n                        ))}\r\n                    </M3DialogContent>\r\n\r\n                    <M3DialogActions>\r\n                        <M3Button type=\"button\" onClick={() => setIsObjectivePickerOpen(false)} variant=\"filled\" className=\"shadow-[var(--md-sys-elevation-level2)]\" style={{ width: \"100%\", fontWeight: \"900\" }}>CONFERMA SELEZIONE</M3Button>\r\n                    </M3DialogActions>\r\n                </M3Dialog>\r\n            )}\r\n        </>\r\n    );\r\n};\r\n\r\nexport { CreateLessonFromAiModal };\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\CurriculumManager.tsx","m