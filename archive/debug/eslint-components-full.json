r\n          Questo ├¿ un esempio di contenuto per il nuovo modale accessibile e responsive.<br />\r\n          Premi <b>ESC</b> o clicca fuori dal modale per chiudere.\r\n        </p>\r\n        <div className=\"mt-8\" style={{ display: \"flex\", justifyContent: \"flex-end\", gap: \"var(--md-sys-spacing-3)\" }}>\r\n          <M3Button\r\n            onClick={() => setOpen(false)}\r\n            variant=\"tonal\"\r\n          >\r\n            Annulla\r\n          </M3Button>\r\n          <M3Button\r\n            onClick={() => {\r\n              alert('Azione confermata!');\r\n              setOpen(false);\r\n            }}\r\n            variant=\"filled\"\r\n          >\r\n            Conferma\r\n          </M3Button>\r\n        </div>\r\n      </UniversalModal>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default UniversalModalDemo;\r\n\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\VideoAnalysisModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":129,"column":22,"nodeType":"JSXAttribute","endLine":129,"endColumn":38},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'p-20' not allowed. Use MD3 tokens in inline styles.","line":129,"column":22,"nodeType":"JSXAttribute","endLine":129,"endColumn":38},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":130,"column":26,"nodeType":"JSXAttribute","endLine":130,"endColumn":46},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":131,"column":30,"nodeType":"JSXAttribute","endLine":131,"endColumn":98},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-4' no