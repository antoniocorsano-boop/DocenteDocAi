mponents. Use inline style with MD3 tokens instead.","line":195,"column":42,"nodeType":"JSXAttribute","endLine":195,"endColumn":58},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":196,"column":46,"nodeType":"JSXAttribute","endLine":196,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-b-2' not allowed. Use MD3 tokens in inline styles.","line":196,"column":46,"nodeType":"JSXAttribute","endLine":196,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-black' not allowed. Use MD3 tokens in inline styles.","line":196,"column":46,"nodeType":"JSXAttribute","endLine":196,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-dotted' not allowed. Use MD3 tokens in inline styles.","line":196,"column":46,"nodeType":"JSXAttribute","endLine":196,"endColumn":95},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":197,"column":46,"nodeType":"JSXAttribute","endLine":197,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-b-2' not allowed. Use MD3 tokens in inline styles.","line":197,"column":46,"nodeType":"JSXAttribute","endLine":197,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-black' not allowed. Use MD3 tokens in inline styles.","line":197,"column":46,"nodeType":"JSXAttribute","endLine":197,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-dotted' not allowed. Use MD3 tokens in inline styles.","line":197,"column":46,"nodeType":"JSXAttribute","endLine":197,"endColumn":95},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":198,"column":46,"nodeType":"JSXAttribute","endLine":198,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-b-2' not allowed. Use MD3 tokens in inline styles.","line":198,"column":46,"nodeType":"JSXAttribute","endLine":198,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-black' not allowed. Use MD3 tokens in inline styles.","line":198,"column":46,"nodeType":"JSXAttribute","endLine":198,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-dotted' not allowed. Use MD3 tokens in inline styles.","line":198,"column":46,"nodeType":"JSXAttribute","endLine":198,"endColumn":95},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":199,"column":46,"nodeType":"JSXAttribute","endLine":199,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-b-2' not allowed. Use MD3 tokens in inline styles.","line":199,"column":46,"nodeType":"JSXAttribute","endLine":199,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-black' not allowed. Use MD3 tokens in inline styles.","line":199,"column":46,"nodeType":"JSXAttribute","endLine":199,"endColumn":95},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-dotted' not allowed. Use MD3 tokens in inline styles.","line":199,"column":46,"nodeType":"JSXAttribute","endLine":199,"endColumn":95},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":204,"column":42,"nodeType":"JSXAttribute","endLine":204,"endColumn":263},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-secondary-container/50' not allowed. Use MD3 tokens in inline styles.","line":204,"column":42,"nodeType":"JSXAttribute","endLine":204,"endColumn":263},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-on-secondary-container' not allowed. Use MD3 tokens in inline styles.","line":204,"column":42,"nodeType":"JSXAttribute","endLine":204,"endColumn":263},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-large)]' not allowed. Use MD3 tokens in inline styles.","line":204,"column":42,"nodeType":"JSXAttribute","endLine":204,"endColumn":263},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-l-8' not allowed. Use MD3 tokens in inline styles.","line":204,"column":42,"nodeType":"JSXAttribute","endLine":204,"endColumn":263},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level2)]' not allowed. Use MD3 tokens in inline styles.","line":204,"column":42,"nodeType":"JSXAttribute","endLine":204,"endColumn":263},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":207,"column":53,"nodeType":"JSXAttribute","endLine":207,"endColumn":81},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":216,"column":26,"nodeType":"JSXAttribute","endLine":216,"endColumn":82},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-black/10' not allowed. Use MD3 tokens in inline styles.","line":216,"column":26,"nodeType":"JSXAttribute","endLine":216,"endColumn":82}],"suppressedMessages":[],"errorCount":80,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState } from 'react';\r\nimport type { jsPDF as JsPDFType } from 'jspdf';\r\nimport { GeneratedQuiz } from '../types';\r\nimport { generateHtmlDocxBlob, viewPdfInNewTab } from '../utils/documentUtils';\r\nimport { saveAs } from '../utils/documentUtils';\r\nimport { M3Dialog, M3Button } from './ui';\r\n\r\ninterface TestPreviewModalProps {\r\n    quiz: GeneratedQuiz;\r\n    onClose: () => void;\r\n}\r\n\r\nconst TestPreviewModal: React.FC<TestPreviewModalProps> = ({ quiz, onClose }) => {\r\n    const [showAnswers, setShowAnswers] = useState(false);\r\n\r\n    const handleExportDocx = async () => {\r\n        let html = `<h1>Verifica: ${quiz.title}</h1>`;\r\n        html += `<p><strong>Argomento:</strong> ${quiz.topic} | <strong>Livello:</strong> ${quiz.difficulty}</p>`;\r\n        html += `<p><strong>Nome Studente:</strong> __________________________ <strong>Data:</strong> ____________</p><hr/>`;\r\n\r\n        quiz.questions.forEach((q, i) => {\r\n            html += `<p><strong>${i + 1}. ${q.text}</strong></p>`;\r\n            if (q.type === 'multiple_choice' && q.options) {\r\n                html += `<ul>`;\r\n                q.options.forEach(opt => html += `<li>[ ] ${opt}</li>`);\r\n                html += `</ul>`;\r\n            } else if (q.type === 'true_false') {\r\n                html += `<p>[ ] Vero  &nbsp;&nbsp; [ ] Falso</p>`;\r\n            } else {\r\n                html += `<p>___________________________________________________________________</p>`;\r\n                html += `<p>___________________________________________________________________</p>`;\r\n            }\r\n\r\n            if (showAnswers) {\r\n                html += `<p style=\"color: green; font-size: 0.9em;\"><em>Risposta corretta: ${q.correctAnswer}</em></p>`;\r\n            }\r\n            html += `<br/>`;\r\n        });\r\n\r\n        const fileName = `Verifica_${quiz.topic.replace(/\\s/g, '_')}_${showAnswers ? 'Docente' : 'Studente'}.docx`;\r\n        const blob = await generateHtmlDocxBlob(html, quiz.title);\r\n        saveAs(blob, fileName);\r\n    };\r\n\r\n    const handleExportPDF = async () => {\r\n        // Lazy load jsPDF to avoid document access during module initialization\r\n        const jsPdfModule = await import('jspdf');\r\n        const jsPDF = jsPdfModule.jsPDF as typeof JsPDFType;\r\n        \r\n        const doc = new jsPDF();\r\n        const margin = 20;\r\n        let y = margin;\r\n        const pageWidth = doc.internal.pageSize.getWidth();\r\n        const maxLineWidth = pageWidth - margin * 2;\r\n\r\n        doc.setFontSize(18).setFont('helvetica', 'bold').text(quiz.title, margin, y);\r\n        y += 10;\r\n        doc.setFontSize(11).setFont('helvetica', 'normal').text(`Argomento: ${quiz.topic}`, margin, y);\r\n        y += 6;\r\n        doc.text(`Nome: __________________________  Data: ____________`, margin, y);\r\n        y += 10;\r\n        doc.line(margin, y, pageWidth - margin, y);\r\n        y += 10;\r\n\r\n        quiz.questions.forEach((q, i) => {\r\n            // Check page break\r\n            if (y > 250) { doc.addPage(); y = margin; }\r\n\r\n            const questionTitle = `${i + 1}. ${q.text}`;\r\n            const splitTitle = doc.splitTextToSize(questionTitle, maxLineWidth);\r\n            doc.setFont('helvetica', 'bold').text(splitTitle, margin, y);\r\n            y += (splitTitle.length * 5) + 2;\r\n\r\n            if (q.type === 'multiple_choice' && q.options) {\r\n                doc.setFont('helvetica', 'normal');\r\n                q.options.forEach(opt => {\r\n                    doc.text(`[ ] ${opt}`, margin + 5, y);\r\n                    y += 6;\r\n                });\r\n            } else if (q.type === 'true_false') {\r\n                doc.setFont('helvetica', 'normal').text(`[ ] Vero   [ ] Falso`, margin + 5, y);\r\n                y += 8;\r\n            } else {\r\n                y += 5;\r\n                doc.line(margin + 5, y, pageWidth - margin, y);\r\n                y += 8;\r\n                doc.line(margin + 5, y, pageWidth - margin, y);\r\n                y += 8;\r\n            }\r\n\r\n            if (showAnswers) {\r\n                doc.setTextColor(0, 150, 0).setFontSize(10).text(`Soluzione: ${q.correctAnswer}`, margin + 5, y);\r\n                doc.setTextColor(0).setFontSize(11);\r\n                y += 6;\r\n            }\r\n            y += 5;\r\n        });\r\n\r\n        const blob = doc.output('blob');\r\n        viewPdfInNewTab(blob);\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            isOpen={true}\r\n            onClose={onClose}\r\n            title=\"Anteprima Verifica\"\r\n            headline=\"Visualizza e stampa la verifica generata\"\r\n            buttons={\r\n                <div className=\"md:flex-row\" style={{ display: \"flex\", flexDirection: \"column\", justifyContent: \"space-between\", width: \"100%\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                    <div className=\"mr-auto\" style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                        <label className=\"hover:bg-[var(--md-sys-color-surface-container-high)]/50 rounded-[var(--md-sys-shape-corner-large)] group\" style={{ display: \"flex\", alignItems: \"center\", cursor: \"pointer\", gap: \"var(--md-sys-spacing-6)\", padding: \"var(--md-sys-spacing-8)\", transition: \"color 300ms\" }}>\r\n                            <div className={`w-12 h-7 rounded-full relative transition-all duration-300 ${showAnswers ? 'bg-primary' : 'bg-[var(--md-sys-color-surface-container-high)]est border border-[var(--md-sys-color-outline-variant)]'}`}>\r\n                                <div className={`absolute top-1 w-5 h-5 rounded-full bg-surface shadow-[var(--md-sys-elevation-level2)] transition-all duration-300 ${showAnswers ? 'left-6' : 'left-1'}`}></div>\r\n                            </div>\r\n                            <input\r\n                                type=\"checkbox\"\r\n                                checked={showAnswers}\r\n                                onChange={e => setShowAnswers(e.target.checked)}\r\n                                style={{ display: \"none\" }}\r\n                            />\r\n                            <span className=\"m3-label-large group-hover:opacity-100\" style={{ fontWeight: \"900\", textTransform: \"uppercase\", letterSpacing: \"0.1em\", opacity: \"0.7\", transition: \"opacity 300ms\" }}>Soluzioni Docente</span>\r\n                        </label>\r\n                    </div>\r\n                    <div style={{ display: \"flex\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                        <M3Button onClick={onClose} variant=\"text\">Chiudi</M3Button>\r\n                        <M3Button \r\n                            onClick={handleExportDocx} \r\n                            variant=\"secondary\"\r\n                            icon=\"description\"\r\n                        >\r\n                            Word\r\n                        </M3Button>\r\n                        <M3Button \r\n                            onClick={handleExportPDF} \r\n                            variant=\"primary\"\r\n                            icon=\"picture_as_pdf\"\r\n                        >\r\n                            PDF\r\n                        </M3Button>\r\n                    </div>\r\n                </div>\r\n            }\r\n            fullscreen={true}\r\n        >\r\n            <div className=\"bg-[var(--md-sys-color-surface-container-low)]/30 backdrop-blur-xl md:p-12 custom-scrollbar relative animate-in fade-in duration-500\" style={{ padding: \"var(--md-sys-spacing-8)\", overflowY: \"auto\", height: \"100%\" }}>\r\n                {/* Aura Ornaments */}\r\n                <div className=\"absolute top-0 left-0 overflow-hidden pointer-events-none\" style={{ width: \"100%\", height: \"100%\" }}>\r\n                    <div className=\"absolute 