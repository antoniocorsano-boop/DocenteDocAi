   </div>\r\n  );\r\n};\r\n\r\n/**\r\n * Skeleton loader for table/list views\r\n */\r\nexport const SkeletonListLoading: React.FC = () => {\r\n  return (\r\n    <div style={{ gap: \"var(--md-sys-spacing-4)\", padding: \"var(--md-sys-spacing-4)\" }}>\r\n      {[1, 2, 3].map(i => (\r\n        <div key={i} className=\"rounded-[var(--md-sys-shape-corner-small)] aura-glass animate-pulse\" style={{ height: \"4rem\" }} />\r\n      ))}\r\n    </div>\r\n  );\r\n};\r\n\r\n/**\r\n * Preload hint - called on route navigation to prefetch next view\r\n */\r\nexport function useViewPreload(viewName: string): void {\r\n  React.useEffect(() => {\r\n    const timer = setTimeout(() => {\r\n      // Trigger prefetch via dynamic import\r\n      import('./viewRegistry/lazyViewLoader').then(mod => {\r\n        if (mod.preloadView) {\r\n          mod.preloadView(viewName);\r\n        }\r\n      }).catch(err => {\r\n        console.warn('[view-preload] Failed to import lazy loader:', err);\r\n      });\r\n    }, 100);\r\n    \r\n    return () => clearTimeout(timer);\r\n  }, [viewName]);\r\n}\r\n\r\nexport default ViewLoadingPlaceholder;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ViewManager.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":163,"column":41,"nodeType":"JSXAttribute","endLine":163,"endColumn":79},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":207,"column":38,"nodeType":"JSXAttribute","endLine":207,"endColumn":78},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":208,"column":41,"nodeType":"JSXAttribute","endLine":208,"endColumn":77},{"ruleId":"design-system/no-classname","s