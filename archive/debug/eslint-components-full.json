 instead.","line":27,"column":21,"nodeType":"JSXAttribute","endLine":27,"endColumn":190},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-typescale-body-medium)]' not allowed. Use MD3 tokens in inline styles.","line":27,"column":21,"nodeType":"JSXAttribute","endLine":27,"endColumn":190},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":27,"column":21,"nodeType":"JSXAttribute","endLine":27,"endColumn":190},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":39,"column":21,"nodeType":"JSXAttribute","endLine":39,"endColumn":47},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":40,"column":21,"nodeType":"JSXAttribute","endLine":40,"endColumn":189},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-typescale-body-medium)]' not allowed. Use MD3 tokens in inline styles.","line":40,"column":21,"nodeType":"JSXAttribute","endLine":40,"endColumn":189},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":40,"column":21,"nodeType":"JSXAttribute","endLine":40,"endColumn":189},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":53,"column":30,"nodeType":"JSXAttribute","endLine":53,"endColumn":60},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'gap-12' not allowed. Use MD3 tokens in inline styles.","line":53,"column":30,"nodeType":"JSXAttribute","endLine":53,"endColumn":60}],"suppressedMessages":[],"errorCount":22,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from 'react';\r\nimport { BackupInfoModalProps } from '../types';\r\nimport { M3Dialog, M3DialogContent, M3DialogActions, M3Button } from './ui';\r\n\r\nconst BackupInfoModal: React.FC<BackupInfoModalProps> = ({ onClose }) => {\r\n    return (\r\n        <M3Dialog\r\n            title=\"Informazioni sul Backup\"\r\n            onClose={onClose}\r\n            maxWidth=\"md\"\r\n            level={1}\r\n            hideBackdrop={true}\r\n        >\r\n            <M3DialogContent className=\"space-y-12 px-12 pt-12 pb-0\" style={{ overflowY: \"auto\" }}>\r\n                <h3 className=\"m3-title-large\" style={{ color: \"var(--md-sys-color-primary)\", marginBottom: \"var(--md-sys-spacing-8)\" }}>Architettura \"Local-First\" e Privacy</h3>\r\n                <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant\" style={{ marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                    OrarioDoc AI ├¿ un'applicazione **Local-First**. Ci├▓ significa che tutti i tuoi dati sensibili (studenti, voti, note, PEI/PDP) vengono salvati **esclusivamente** sul tuo dispositivo, nel browser che stai utilizzando (IndexedDB e LocalStorage).\r\n                </p>\r\n                <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant mb-12\">\r\n                    **Non esiste un server centrale di OrarioDoc AI** che raccolga o abbia accesso ai tuoi dati. Questo garantisce la massima privacy e la tua totale sovranit├á sui dati.\r\n                </p>\r\n\r\n                <h3 className=\"m3-title-large\" style={{ color: \"var(--md-sys-color-secondary)\", marginBottom: \"var(--md-sys-spacing-8)\" }}>Backup su Google Drive (BYOC)</h3>\r\n                <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant\" style={{ marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                    Per evitare la perdita dei dati in caso di problemi al dispositivo (guasti, smarrimento, pulizia cache del browser), ├¿ fortemente consigliato attivare il backup su Google Drive.\r\n                </p>\r\n                <ul className=\"list-disc pl-8 text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant mb-12\" style={{ gap: \"var(--md-sys-spacing-4)\" }}>\r\n                    <li>\r\n                        **Bring Your Own Cloud (BYOC):** Il backup avviene sul **tuo account Google Drive personale o istituzionale**. L'app non salva nulla su server di terzi.\r\n                    </li>\r\n                    <li>\r\n                        **Controllo Accessi:** L'app richiede l'accesso con protocollo OAuth 2.0 e **pu├▓ accedere solo ai file che essa stessa crea** (scope `drive.file`). Non pu├▓ leggere altri tuoi documenti, email o dati su Drive.\r\n                    </li>\r\n                    <li>\r\n                        **Backup Monolitico:** Viene creato un singolo file `OrarioDoc_Backup.json` che contiene tutti i dati dell'app (configurazioni, studenti, lezioni, voti, Knowledge Base). Questo mantiene il tuo Drive pulito e organizzato.\r\n                    </li>\r\n                </ul>\r\n\r\n                <h3 className=\"m3-title-large\" style={{ color: \"var(--md-sys-color-tertiary)\", marginBottom: \"var(--md-sys-spacing-8)\" }}>Sincronizzazione Automatica e Manuale</h3>\r\n                <ul className=\"list-disc pl-8 text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant mb-0\" style={{ gap: \"var(--md-sys-spacing-4)\" }}>\r\n                    <li>\r\n                        **Manuale:** Puoi eseguire un backup o ripristino in qualsiasi momento tramite i pulsanti \"Backup Ora\" e \"Ripristina\".\r\n                    </li>\r\n                    <li>\r\n                        **Automatico:** Se abilitato, l'app salver├á automaticamente una copia dei tuoi dati su Google Drive a intervalli regolari (es. ogni 5 minuti), assicurando che le tue modifiche siano sempre protette.\r\n                    </li>\r\n                    <li>\r\n                        **Risoluzione Conflitti:** In caso di un backup pi├╣ recente su Drive rispetto al tuo dispositivo, l'app ti avviser├á prima di sovrascrivere i dati, permettendoti di scegliere cosa fare.\r\n                    </li>\r\n                </ul>\r\n            </M3DialogContent>\r\n\r\n            <M3DialogActions className=\"gap-12 px-12 pb-12\" style={{ paddingTop: \"0\" }}>\r\n                <M3Button onClick={onClose} variant=\"filled\">Ho capito</M3Button>\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default BackupInfoModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\BatchExportWizard.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":274,"column":18,"nodeType":"JSXAttribute","endLine":274,"endColumn":116},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-[var(--md-sys-color-surface-container)]' not allowed. Use MD3 tokens in inline styles.","line":274,"column":18,"nodeType":"JSXAttribute","endLine":274,"endColumn":116},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-medium)]' not allowed. Use MD3 tokens in inline styles.","line":274,"column":18,"nodeType":"JSXAttribute","endLine":274,"e