ethodology' && <M3Button onClick={() => setStep('sequence')} variant=\"filled\" title=\"Vai al piano\">Avanti</M3Button>}\r\n                            {step === 'sequence' && <M3Button onClick={() => { calculateSchedule(); setStep('preview'); }} disabled={plannedUdas.length === 0} variant=\"filled\" title=\"Calcola date\">Calcola</M3Button>}\r\n                            {step === 'preview' && <M3Button onClick={handleFinalize} disabled={isProcessing} variant=\"filled\" style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }} title=\"Salva tutto nel database\">{isProcessing ? <AiThinkingGem size=\"small\" inline /> : 'Conferma e Salva'}</M3Button>}\r\n                        </>\r\n                    )}\r\n                    {step === 'document' && <M3Button onClick={onClose} variant=\"text\" title=\"Chiudi wizard\">Chiudi</M3Button>}\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default AnnualPlanningWizard;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ClassSelection.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":50,"column":14,"nodeType":"JSXAttribute","endLine":50,"endColumn":43},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":52,"column":18,"nodeType":"JSXAttribute","endLine":52,"endColumn":49},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":53,"column":22,"nodeType":"JSXAttribute","endLine":53,"endColumn":57},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":54,"column":25,"nodeTy