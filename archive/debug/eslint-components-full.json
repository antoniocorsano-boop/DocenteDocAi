 Error;\r\n}\r\n\r\nclass ErrorBoundary extends Component<ErrorBoundaryProps, ErrorBoundaryState> {\r\n\tconstructor(props: ErrorBoundaryProps) {\r\n\t\tsuper(props);\r\n\t\tthis.state = { hasError: false };\r\n\t}\r\n\r\n\tstatic getDerivedStateFromError(error: Error): ErrorBoundaryState {\r\n\t\treturn { hasError: true, error };\r\n\t}\r\n\r\n\tcomponentDidCatch(error: Error, errorInfo: ErrorInfo): void {\r\n\t\tconsole.error('ErrorBoundary caught an error:', error, errorInfo);\r\n        console.error('ErrorBoundary: Full error stack:', error.stack);\r\n\t\t// For now, we'll just log it and show a user-friendly message\r\n\t}\r\n\r\n\trender(): React.ReactElement {\r\n\t\tif (this.state.hasError) {\r\n\t\t\treturn <ErrorFallback error={this.state.error} />;\r\n\t\t}\r\n\r\n\t\treturn this.props.children;\r\n\t}\r\n}\r\n\r\n// Separate component to use hooks\r\nconst ErrorFallback: React.FC<{ error?: Error }> = ({ error }) => {\r\n\tconst { showToast } = useUIStore(state => ({ showToast: state.actions.showToast }));\r\n\r\n\tReact.useEffect(() => {\r\n\t\tshowToast(\r\n\t\t\t\"Si ├¿ verificato un errore imprevisto. L'applicazione verr├á ricaricata.\",\r\n\t\t\t\"error\"\r\n\t\t);\r\n\r\n\t\t// Auto-reload after a short delay to give user time to see the message\r\n\t\tconst timer = setTimeout(() => {\r\n\t\t\twindow.location.reload();\r\n\t\t}, 3000);\r\n\r\n\t\treturn () => clearTimeout(timer);\r\n\t}, [showToast]);\r\n\r\n\treturn (\r\n\t\t<div className=\"error-boundary-container\">\r\n\t\t\t<div className=\"error-boundary-card\">\r\n\t\t\t\t<div className=\"error-boundary-icon-container\">\r\n\t\t\t\t\t<span className=\"material-symbols-outlined error-boundary-icon\">error</span>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<h2 className=\"error-boundary-title\">\r\n\t\t\t\t\tOops! Qualcosa ├¿ andato storto\r\n\t\t\t\t</h2>\r\n\r\n\t\t\t\t<p className=\"error-boundary-description\">\r\n\t\t\t\t\tSi ├¿ verificato un errore imprevisto nell'applicazione.\r\n\t\t\t\t\tLa pagina verr├á ricaricata automaticamente tra pochi secondi.\r\n\t\t\t\t</p>\r\n\r\n\t\t\t\t<div className=\"error-boundary-loading\">\r\n\t\t\t\t\t<span className=\"material-symbols-outlined error-boundary-loading-icon\">refresh</span>\r\n\t\t\t\t\t<span>Ricaricamento in corso...</span>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t{process.env.NODE_ENV === 'development' && error && (\r\n\t\t\t\t\t<details className=\"error-boundary-details\">\r\n\t\t\t\t\t\t<summary className=\"error-boundary-details-summary\">\r\n\t\t\t\t\t\t\tDettagli errore (solo in sviluppo)\r\n\t\t\t\t\t\t</summary>\r\n\t\t\t\t\t\t<pre className=\"error-boundary-details-pre\">\r\n\t\t\t\t\t\t\t{error.stack}\r\n\t\t\t\t\t\t</pre>\r\n\t\t\t\t\t</details>\r\n\t\t\t\t)}\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t);\r\n};\r\n\r\nexport { ErrorBoundary };\r\nexport default ErrorBoundary;\r\n\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ErrorLogsDashboard.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":69,"column":10,"nodeType":"JSXAttribute","endLine":69,"endColumn":31},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'max-w-6xl' not allowed. Use MD3 tokens in inline styles.","line":69,"column":10,"nodeType":"JSXAttribute","endLine":69,"endColumn":31},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":71,"column":13,"nodeType":"JSXAttribute","endLine":71,"endColumn":43},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-typescale-headline-small)]' not allowed. Use MD3 tokens in inline styles.","line":73,"column":37,"nodeType":"JSXAttribute","endLine":73,"endColumn":171},{"ruleId":"design-system/no-classname","severity":2,"message":"classN