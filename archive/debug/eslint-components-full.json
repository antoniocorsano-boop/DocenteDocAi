      {step === 'upload' && (\r\n                    <M3Button onClick={onClose} variant=\"text\">Annulla</M3Button>\r\n                )}\r\n                {step === 'mapping' && (\r\n                    <>\r\n                        <M3Button type=\"button\" onClick={() => { setStep('upload'); setInfoMessage(''); setError(''); }} variant=\"text\">Indietro</M3Button>\r\n                        <M3Button type=\"button\" onClick={() => setStep('confirm')} disabled={!columnMap.cognome || !columnMap.nome || (targetClass === 'AUTO' && !columnMap.classe)} variant=\"filled\">Avanti</M3Button>\r\n                    </>\r\n                )}\r\n                {step === 'confirm' && (\r\n                    <>\r\n                        <M3Button type=\"button\" onClick={() => setStep('mapping')} variant=\"text\">Indietro</M3Button>\r\n                        <M3Button type=\"button\" onClick={handleImport} variant=\"filled\">Importa Studenti</M3Button>\r\n                    </>\r\n                )}\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default ImportStudentsModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ImpromptuLessonModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":49,"column":34,"nodeType":"JSXAttribute","endLine":49,"endColumn":113},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-[var(--md-sys-color-surface-container-high)]/30' not allowed. Use MD3 tokens in inline styles.","line":49,"column":34,"nodeType":"JSXAttribute","endLine":49,"endColumn":113},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":81,"column":34,"nodeType":"JSXAttribute","endLine":81,"endColumn":161},