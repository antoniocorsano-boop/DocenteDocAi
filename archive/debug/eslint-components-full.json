ribute","endLine":54,"endColumn":76},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level2)]' not allowed. Use MD3 tokens in inline styles.","line":54,"column":25,"nodeType":"JSXAttribute","endLine":54,"endColumn":76}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\r\nimport { TextArea, M3Dialog, M3DialogContent, M3DialogActions, M3Button } from './ui';\r\n\r\ninterface ImageGeneratorModalProps {\r\n    onClose: () => void;\r\n    onGenerate: (prompt: string) => void;\r\n}\r\n\r\nconst ImageGeneratorModal: React.FC<ImageGeneratorModalProps> = ({ onClose, onGenerate }) => {\r\n    const [prompt, setPrompt] = useState('');\r\n\r\n    const handleSubmit = () => {\r\n        if (!prompt.trim()) {\r\n            return;\r\n        }\r\n        onGenerate(prompt);\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            title={\r\n                <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                    <span className=\"material-symbols-outlined\" style={{ color: \"var(--md-sys-color-primary)\" }}>image</span>\r\n                    <span>AI Image Lab</span>\r\n                </div>\r\n            }\r\n            onClose={onClose}\r\n            maxWidth=\"sm\"\r\n            level={1}\r\n        >\r\n            <form onSubmit={(e) => { e.preventDefault(); handleSubmit(); }} style={{ display: \"flex\", flexDirection: \"column\", height: \"100%\" }}>\r\n                <M3DialogContent className=\"bg-[var(--md-sys-color-surface-container-low)]/30 backdrop-blur-xl p-12 space-y-12\">\r\n                    <TextArea\r\n                        id=\"image-generator-prompt\"\r\n                        label=\"Descrizione Immagine\"\r\n                        value={prompt}\r\n                        onChange={(e) => setPrompt(e.target.value)}\r\n                        rows={6}\r\n                        placeholder=\"Es. 'Illustrazione minimalista del ciclo dell'acqua per una lezione di scienze, stile flat design'...\"\r\n                        autoFocus\r\n                        className=\"bg-[var(--md-sys-color-surface-container-high)]/50\"\r\n                    />\r\n                    <p className=\"text-[10px] text-[var(--md-sys-color-on-surface)]-variant px-8\" style={{ fontWeight: \"900\", textTransform: \"uppercase\", letterSpacing: \"0.1em\", opacity: \"0.6\" }}>\r\n                        L'AI generer├á un'immagine basata sulla tua descrizione. Sii specifico per risultati migliori.\r\n                    </p>\r\n                </M3DialogContent>\r\n\r\n                <M3DialogActions className=\"bg-[var(--md-sys-color-surface-container-low)]/30 backdrop-blur-xl border-[var(--md-sys-color-outline-variant)]/10 px-12 pb-12 gap-12\" style={{ borderTop: \"1px solid var(--md-sys-color-outline)\", paddingTop: \"0\" }}>\r\n                    <M3Button onClick={onClose} variant=\"text\" style={{ fontWeight: \"900\", fontSize: \"0.75rem\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Annulla</M3Button>\r\n                    <M3Button \r\n                        onClick={handleSubmit} \r\n                        variant=\"filled\" \r\n                        disabled={!prompt.trim()}\r\n                        className=\"shadow-[var(--md-sys-elevation-level2)]\" style={{ fontWeight: \"900\", fontSize: \"0.75rem\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}\r\n                    >\r\n                        <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\", fontSize: \"0.875rem\" }}>auto_awesome</span>\r\n                        Genera Immagine\r\n                    </M3Button>\r\n                </M3DialogActions>\r\n            </form>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default ImageGeneratorModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ImageViewerModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":40,"column":30,"nodeType":"JSXAttribute","endLine":40,"endColumn":109},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-[var(--md-sys-color-surface-container-high)]/30' not allowed. Use MD3 tokens in inline styles.","line":40,"column":30,"nodeType":"JSXAttribute","endLine":40,"endColumn":109},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":41,"column":22,"nodeType":"JSXAttribute","endLine":41,"endColumn":48},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":45,"column":25,"nodeType":"JSXAttribute","endLine":45,"endColumn":163},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'max-h-[70vh]' not allowed. Use MD3 tokens in inline styles.","line":45,"column":25,"nodeType":"JSXAttribute","endLine":45,"endColumn":163},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-large)]' not allowed. Use MD3 tokens in inline styles.","line":45,"column":25,"nodeType":"JSXAttribute","endLine":45,"endColumn":163},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level4)]' not allowed. Use MD3 tokens in inline styles.","line":45,"column":25,"nodeType":"JSXAttribute","endLine":45,"endColumn":163},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-white/10' not allowed. Use MD3 tokens in inline styles.","line":45,"colu