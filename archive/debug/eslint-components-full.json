e","endLine":41,"endColumn":139},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":47,"column":21,"nodeType":"JSXAttribute","endLine":47,"endColumn":57}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState } from 'react';\r\nimport { M3Dialog, M3DialogContent, M3DialogActions, M3Button, TextField } from './ui';\r\n\r\ninterface ResetConfirmModalProps {\r\n    onClose: () => void;\r\n    onConfirm: () => void;\r\n}\r\n\r\nconst ResetConfirmModal: React.FC<ResetConfirmModalProps> = ({ onClose, onConfirm }) => {\r\n    const [confirmText, setConfirmText] = useState('');\r\n    const isValid = confirmText === 'CANCELLA';\r\n\r\n    return (\r\n        <M3Dialog\r\n            title=\"Attenzione\"\r\n            onClose={onClose}\r\n            maxWidth=\"sm\"\r\n            level={3}\r\n        >\r\n            <M3DialogContent className=\"bg-[var(--md-sys-color-surface-container-high)]/30 backdrop-blur-sm\" style={{ gap: \"var(--md-sys-spacing-6)\" }}>\r\n                <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\", color: \"var(--md-sys-color-error)\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                    <span className=\"material-symbols-outlined text-3xl\">warning</span>\r\n                    <span style={{ fontWeight: \"bold\" }}>Azione Irreversibile</span>\r\n                </div>\r\n                <p className=\"text-[var(--md-sys-typescale-body-large)] font-[var(--md-sys-typescale-body-large-font)]\" style={{ lineHeight: \"1.625\" }}>\r\n                    Stai per cancellare <strong>TUTTI</strong> i dati locali (studenti, voti, lezioni). \r\n                    Questa azione ├¿ <strong style={{ color: \"var(--md-sys-color-error)\" }}>irreversibile</strong> se non hai un backup su Drive.\r\n                </p>\r\n                \r\n                <TextField \r\n                    label='Digita \"CANCELLA\" per confermare'\r\n                    value={confirmText}\r\n                    onChange={e => setConfirmText(e.target.value)}\r\n                    placeholder=\"CANCELLA\"\r\n                    autoFocus\r\n                    error={confirmText.length > 0 && !isValid && confirmText.length >= 8}\r\n                />\r\n            </M3DialogContent>\r\n\r\n            <M3DialogActions className=\"bg-[var(--md-sys-color-surface-container-low)]est border-[var(--md-sys-color-outline-variant)]/30\" style={{ borderTop: \"1px solid var(--md-sys-color-outline)\" }}>\r\n                <M3Button onClick={onClose} variant=\"text\">Annulla</M3Button>\r\n                <M3Button \r\n                    onClick={onConfirm} \r\n                    disabled={!isValid}\r\n                    variant=\"filled\"\r\n                    className=\"!bg-error !text-on-error\"\r\n                >\r\n                    Reset Totale\r\n                </M3Button>\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default ResetConfirmModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\RestoreAssistController.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\RestoreAssistModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":30,"column":24,"nodeType":"JSXAttribute","endLine":30,"endColumn":64},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens ins