":"Tailwind class 'bg-[var(--md-sys-color-surface-container-low)]/30' not allowed. Use MD3 tokens in inline styles.","line":133,"column":30,"nodeType":"JSXAttribute","endLine":133,"endColumn":175},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-[var(--md-sys-color-outline-variant)]/10' not allowed. Use MD3 tokens in inline styles.","line":133,"column":30,"nodeType":"JSXAttribute","endLine":133,"endColumn":175},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'gap-12' not allowed. Use MD3 tokens in inline styles.","line":133,"column":30,"nodeType":"JSXAttribute","endLine":133,"endColumn":175},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":139,"column":21,"nodeType":"JSXAttribute","endLine":139,"endColumn":79},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level2)]' not allowed. Use MD3 tokens in inline styles.","line":139,"column":21,"nodeType":"JSXAttribute","endLine":139,"endColumn":79}],"suppressedMessages":[],"errorCount":42,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\nimport { AiSettings, KnowledgeBaseEntry } from '../types';\r\nimport VoiceNoteRecorder from './VoiceNoteRecorder';\r\nimport { generateLessonFromIdea } from '../services/aiService';\r\nimport { SelectField, TextArea, M3Dialog, M3DialogContent, M3DialogActions, M3Button, AiThinkingGem } from './ui';\r\n\r\ninterface IdeaGeneratorModalProps {\r\n    onClose: () => void;\r\n    onGenerate: (content: { title: string; htmlContent: string }) => void;\r\n    aiSettings: AiSettings;\r\n    userClasses: string[];\r\n    knowledgeBase: KnowledgeBaseEntry[];\r\n}\r\n\r\nconst IdeaGeneratorModal: React.FC<IdeaGeneratorModalProps> = ({ onClose, onGenerate, aiSettings, userClasses, knowledgeBase }) => {\r\n    const [ideaText, setIdeaText] = useState('');\r\n    const [targetClass, setTargetClass] = useState<string>(userClasses[0] || '');\r\n    const [useKb, setUseKb] = useState(true);\r\n    const [selectedKbIds, setSelectedKbIds] = useState<string[]>([]);\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [error, setError] = useState('');\r\n\r\n    useEffect(() => {\r\n        if (knowledgeBase.length > 0) {\r\n            const defaults = knowledgeBase\r\n                .filter(k => k.category === 'programmazione' || k.fileName.toLowerCase().includes('programmazione'))\r\n                .map(k => k.id);\r\n            setSelectedKbIds(defaults);\r\n        }\r\n    }, [knowledgeBase]);\r\n\r\n    const handleTranscription = (text: string) => {\r\n        setIdeaText(prev => prev ? `${prev} ${text}` : text);\r\n    };\r\n\r\n    const handleKbToggle = (id: string) => {\r\n        setSelectedKbIds(prev => prev.includes(id) ? prev.filter(k => k !== id) : [...prev, id]);\r\n    };\r\n\r\n    const handleGenerate = async () => {\r\n        if (!ideaText.trim()) { setError(\"Descrivi la tua idea.\"); return; }\r\n        if (!targetClass) { setError(\"Seleziona una classe.\"); return; }\r\n\r\n        setIsLoading(true);\r\n        setError('');\r\n        try {\r\n            const kbContent = useKb \r\n                ? knowledgeBase.filter(k => selectedKbIds.includes(k.id)).map(k => `--- ${k.fileName} ---\\n${k.content}`).join('\\n\\n') \r\n                : undefined;\r\n                \r\n            const result = await generateLessonFromIdea(aiSettings, ideaText, targetClass, kbContent);\r\n            onGenerate(result);\r\n            onClose();\r\n        } catch (err: unknown) {\r\n                let message = 'Errore durante la generazione delle idee.';\r\n                if (err instanceof Error) message = err.message;\r\n                setError(message);\r\n        } finally {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            title={\r\n                <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                    <span className=\"material-symbols-outlined\" style={{ color: \"var(--md-sys-color-tertiary)\" }}>lightbulb</span>\r\n                    <span>AI Lesson Lab</span>\r\n                </div>\r\n            }\r\n            onClose={onClose}\r\n            maxWidth=\"xl\"\r\n            level={1}\r\n        >\r\n            <M3DialogContent className=\"bg-[var(--md-sys-color-surface-container-low)]/30 backdrop-blur-xl p-12 space-y-12\">\r\n                <SelectField \r\n                    label=\"Classe Destinazione\" \r\n                    value={targetClass} \r\n                    onChange={e => setTargetClass(e.target.value)}\r\n                    className=\"bg-[var(--md-sys-color-surface-container-high)]/50\"\r\n                >\r\n                    <option value=\"\" disabled>Seleziona...</option>\r\n                    {userClasses.map(c => <option key={c} value={c}>{c}</option>)}\r\n                </SelectField>\r\n\r\n                <div className=\"relative\">\r\n                    <VoiceNoteRecorder onTranscription={handleTranscription} compact />\r\n                </div>\r\n                <TextArea \r\n                    label=\"Descrizione Idea\" \r\n                    value={ideaText} \r\n                    onChange={e => setIdeaText(e.target.value)} \r\n                    rows={6} \r\n                    placeholder=\"Es. 'Lezione attiva su Dante usando i social media'...\" \r\n                    autoFocus\r\n                    className=\"bg-[var(--md-sys-color-surface-container-high)]/50\"\r\n                />\r\n\r\n                <div className=\"space-y-12\">\r\n                    <div className=\"px-8\" style={{ display: \"flex\", alignItems: \"center\", justifyContent: \"space-between\" }}>\r\n                        <label className=\"select-none\" style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\", cursor: \"pointer\" }}>\r\n                            <div className=\"switch\"><input type=\"checkbox\" checked={useKb} onChange={e => setUseKb(e.target.checked)} /><span className=\"slider\"></span></div>\r\n                            <span className=\"text-[11px] text-[var(--md-sys-color-on-surface)]-variant\" style={{ fontWeight: \"900\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Usa Context Knowledge Base</span>\r\n                        </label>\r\n                        <span className=\"text-[10px]\" style={{ fontWeight: \"900\", textTransform: \"uppercase\", color: \"var(--md-sys-color-primary)\", letterSpacing: \"0.1em\" }}>{selectedKbIds.length} file</span>\r\n                    </div>\r\n                    \r\n                    {useKb && knowledgeBase.length > 0 && (\r\n                        <div className=\"sm:grid-cols-2 gap-12 p-12 bg-[var(--md-sys-color-surface-container-low)]/50 rounded-[var(--md-sys-shape-corner-medium)] border-[var(--md-sys-color-outline-variant)]/10 max-h-48\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", border: \"1px solid var(--md-sys-color-outline)\", overflowY: \"auto\" }}>\r\n                            {knowledgeBase.map(k => (\r\n                                <label key={k.id} className={`flex items-center gap-8 p-12 rounded-[var(--md-sys-shape-corner-large)] border transition-all cursor-pointer ${selectedKbIds.includes(k.id) ? 'bg-primary/10 border-primary/30' : 'bg-[var(--md-sys-color-surface-container-high)]/30 border-[var(--md-sys-color-outline-variant)]/10'}`}>\r\n                                    <input type=\"checkbox\" checked={selectedKbIds.includes(k.id)} onChange={() => handleKbToggle(k.id)} style={{ display: \"none\" }} />\r\n                                    <span className={`material-symbols-outlined text-sm ${selectedKbIds.includes(k.id) ? 'text-primary' : 'text-[var(--md-sys-color-on-surface)]-variant'}`}>\r\n                                        {selectedKbIds.includes(k.id) ? 'check_box' : 'check_box_outline_blank'}\r\n                                    </span>\r\n                                    <span className=\"text-[10px]\" style={{ fontWeight: \"900\", textTransform: \"uppercase\", letterSpacing: \"0.1em\", overflow: \"hidden\", textOverflow: \"ellipsis\", whiteSpace: \"nowrap\" }}>{k.fileName}</span>\r\n                                </label>\r\n                            ))}\r\n                        </div>\r\n                    )}\r\n                </div>\r\n\r\n                {error && (\r\n                    <div className=\"p-12 bg-error/10 border-error/20 rounded-[var(--md-sys-shape-corner-large)]\" style={{ border: \"1px solid var(--md-sys-color-outline)\", display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\", color: \"var(--md-sys-color-error)\" }}>\r\n                        <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}}>error</span>\r\n                        <p style={{ fontSize: \"0.75rem\", fontWeight: \"900\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>{error}</p>\r\n                    </div>\r\n                )}\r\n            </M3DialogContent>\r\n\r\n            <M3DialogActions className=\"bg-[var(--md-sys-color-surface-container-low)]/30 backdrop-blur-xl border-[var(--md-sys-color-outline-variant)]/10 px-12 pb-12 gap-12\" style={{ borderTop: \"1px solid var(--md-sys-color-outline)\", paddingTop: \"0\" }}>\r\n                <M3Button onClick={onClose} variant=\"text\" style={{ fontWeight: \"900\", fontSize: \"0.75rem\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Annulla</M3Button>\r\n                <M3Button \r\n                    onClick={handleGenerate} \r\n                    variant=\"filled\" \r\n                    disabled={isLoading || !ideaText.trim()}\r\n                    className=\"shadow-[var(--md-sys-elevation-level2)] !px-10\" style={{ fontWeight: \"900\", fontSize: \"0.75rem\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}\r\n                >\r\n                    {isLoading ? <AiThinkingGem size={20} /> : (\r\n                        <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                            <span className=\"material-symbols-outlined\" style={{ fontSize: \"0.875rem\" }}>auto_awesome</span>\r\n                            <span>Genera Piano</span>\r\n                        </div>\r\n                    )}\r\n                </M3Button>\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default IdeaGeneratorModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ImageAnalysisModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":80,"column":24,"nodeType":"JSXAttribute","endLine":80,"endColumn":145},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-[var(--md-sys-color-surface-container-high)]/30' not allowed. Use MD3 tokens in inline styles.","line":80,"column":24,"nodeType":"JSXAttribute","endLine":80,"endColumn":145},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'gap-0' not allowed. Use MD3 tokens in inline styles.","line":80,"column":24,"nodeType":"JSXAttribute","endLine":80,"endColumn":145},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":82,"column":14,"nodeType":"JSXAttribute","endLine":82,"endColumn":82},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'p-12' not all