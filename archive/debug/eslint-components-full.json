wind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":54,"column":24,"nodeType":"JSXAttribute","endLine":54,"endColumn":172},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":62,"column":29,"nodeType":"JSXAttribute","endLine":66,"endColumn":32},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":72,"column":24,"nodeType":"JSXAttribute","endLine":72,"endColumn":49},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":77,"column":61,"nodeType":"JSXAttribute","endLine":77,"endColumn":77}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState, useEffect } from 'react';\r\nimport { M3Dialog, M3DialogContent, PinPad, M3Button } from './ui';\r\n\r\ninterface PinPadModalProps {\r\n    title: string;\r\n    correctPin: string;\r\n    onSuccess: () => void;\r\n    onCancel: () => void;\r\n}\r\n\r\nconst PinPadModal: React.FC<PinPadModalProps> = ({ title, correctPin, onSuccess, onCancel }) => {\r\n    const [pin, setPin] = useState('');\r\n    const [error, setError] = useState(false);\r\n\r\n    useEffect(() => {\r\n        if (pin.length === 4) {\r\n            if (pin === correctPin) {\r\n                onSuccess();\r\n            } else {\r\n                setError(true);\r\n                setTimeout(() => {\r\n                    setPin('');\r\n                    setError(false);\r\n                }, 500);\r\n            }\r\n        }\r\n    }, [pin, correctPin, onSuccess]);\r\n\r\n    const handleInput = (digit: string) => {\r\n        if (pin.length < 4) {\r\n            setPin(prev => prev + digit);\r\n            setError(false);\r\n        }\r\n    };\r\n\r\n    const handleDelete = () => {\r\n        setPin(prev => prev.slice(0, -1));\r\n        setError(false);\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            title={title}\r\n            onClose={onCancel}\r\n            maxWidth=\"sm\"\r\n            level={3}\r\n        >\r\n            <M3DialogContent className=\"py-8 bg-[var(--md-sys-color-surface-container-high)]/30 backdrop-blur-sm\" style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", justifyContent: \"center\", width: \"100%\" }}>\r\n                <div style={{ textAlign: \"center\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                    <div className=\"text-on-primary-container shadow-[var(--md-sys-elevation-level1)]\" style={{ width: \"4rem\", height: \"4rem\", backgroundColor: \"var(--md-sys-color-primary-container)\", borderRadius: \"9999px\", display: \"flex\", alignItems: \"center\", justifyContent: \"center\", marginLeft: \"auto\", marginRight: \"auto\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                        <span className=\"material-symbols-outlined text-3xl\">lock</span>\r\n                    </div>\r\n                    <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant\" style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>Inserisci il PIN docente per uscire</p>\r\n                </div>\r\n\r\n                {/* PIN Display */}\r\n                <div style={{ display: \"flex\", justifyContent: \"center\", gap: \"var(--md-sys-spacing-8)\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                    {[0, 1, 2, 3].map((i) => (\r\n                        <div \r\n                            key={i}\r\n                            className={`w-4 h-4 rounded-full transition-all duration-200 ${\r\n                                i < pin.length \r\n                                    ? (error ? 'bg-error scale-125' : 'bg-primary scale-110') \r\n                                    : 'bg-[var(--md-sys-color-surface-container-high)]est border border-[var(--md-sys-color-outline)]'\r\n                            }`}\r\n                        />\r\n                    ))}\r\n                </div>\r\n\r\n                {error && (\r\n                    <p className=\"animate-pulse\" style={{ color: \"var(--md-sys-color-error)\", textAlign: \"center\", fontSize: \"0.875rem\", fontWeight: \"bold\", marginBottom: \"var(--md-sys-spacing-8)\" }}>PIN Errato</p>\r\n                )}\r\n\r\n                <PinPad onInput={handleInput} onDelete={handleDelete} />\r\n\r\n                <M3Button onClick={onCancel} variant=\"text\" className=\"mt-8\" style={{ width: \"100%\" }}>\r\n                    Annulla\r\n                </M3Button>\r\n            </M3DialogContent>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default PinPadModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ProfileSelectionScreen.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":13,"column":10,"nodeType":"JSXAttribute","endLine":13,"endColumn":46},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":14,"column":12,"nodeType":"JSXAttribute","endLine":14,"endColumn":46},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":15,"column":13,"nodeType":"JSXAttribute","endLine":15,"endColumn":43},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 