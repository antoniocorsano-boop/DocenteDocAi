/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-large)]' not allowed. Use MD3 tokens in inline styles.","line":114,"column":26,"nodeType":"JSXAttribute","endLine":114,"endColumn":191},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-dashed' not allowed. Use MD3 tokens in inline styles.","line":114,"column":26,"nodeType":"JSXAttribute","endLine":114,"endColumn":191},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-[var(--md-sys-color-outline-variant)]' not allowed. Use MD3 tokens in inline styles.","line":114,"column":26,"nodeType":"JSXAttribute","endLine":114,"endColumn":191},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-6xl' not allowed. Use MD3 tokens in inline styles.","line":115,"column":31,"nodeType":"JSXAttribute","endLine":115,"endColumn":126},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant/50' not allowed. Use MD3 tokens in inline styles.","line":115,"column":31,"nodeType":"JSXAttribute","endLine":115,"endColumn":126},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":116,"column":28,"nodeType":"JSXAttribute","endLine":116,"endColumn":182},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-typescale-headline-small)]' not allowed. Use MD3 tokens in inline styles.","line":116,"column":28,"nodeType":"JSXAttribute","endLine":116,"endColumn":182},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":116,"column":28,"nodeType":"JSXAttribute","endLine":116,"endColumn":182},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":117,"column":28,"nodeType":"JSXAttribute","endLine":117,"endColumn":176},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-typescale-body-medium)]' not allowed. Use MD3 tokens in inline styles.","line":117,"column":28,"nodeType":"JSXAttribute","endLine":117,"endColumn":176},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":117,"column":28,"nodeType":"JSXAttribute","endLine":117,"endColumn":176},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":134,"column":22,"nodeType":"JSXAttribute","endLine":134,"endColumn":49},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":137,"column":25,"nodeType":"JSXAttribute","endLine":137,"endColumn":75},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":140,"column":31,"nodeType":"JSXAttribute","endLine":140,"endColumn":53},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":141,"column":31,"nodeType":"JSXAttribute","endLine":141,"endColumn":56},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":146,"column":25,"nodeType":"JSXAttribute","endLine":146,"endColumn":73},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":149,"column":31,"nodeType":"JSXAttribute","endLine":149,"endColumn":53},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":150,"column":31,"nodeType":"JSXAttribute","endLine":150,"endColumn":56},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":155,"column":25,"nodeType":"JSXAttribute","endLine":155,"endColumn":74},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":158,"column":31,"nodeType":"JSXAttribute","endLine":158,"endColumn":53},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":159,"column":31,"nodeType":"JSXAttribute","endLine":159,"endColumn":56},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":164,"column":25,"nodeType":"JSXAttribute","endLine":164,"endColumn":73},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":167,"column":31,"nodeType":"JSXAttribute","endLine":167,"endColumn":53},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":168,"column":31,"nodeType":"JSXAttribute","endLine":168,"endColumn":56},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":239,"column":24,"nodeType":"JSXAttribute","endLine":239,"endColumn":81},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":239,"column":24,"nodeType":"JSXAttribute","endLine":239,"endColumn":81},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":242,"column":32,"nodeType":"JSXAttribute","endLine":242,"endColumn":94},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":242,"column":32,"nodeType":"JSXAttribute","endLine":242,"endColumn":94},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":254,"column":32,"nodeType":"JSXAttribute","endLine":254,"endColumn":94},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":254,"column":32,"nodeType":"JSXAttribute","endLine":254,"endColumn":94},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":260,"column":37,"nodeType":"JSXAttribute","endLine":264,"endColumn":40}],"suppressedMessages":[],"errorCount":52,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState, useMemo } from 'react';\r\nimport { View, Valutazione } from '../types';\r\nimport { calculatePerformance } from '../utils/evaluationUtils';\r\nimport { generateCouncilDataPdf } from '../utils/documentUtils';\r\nimport { saveAs } from '../utils/documentUtils';\r\nimport { M3Dialog, M3DialogContent, M3DialogActions, M3Button, SectionHeader, TabGroup, M3ExpressiveCard } from './ui';\r\nimport { useStudentStore } from '../stores/useStudentStore';\r\nimport { useSettingsStore } from '../stores/useSettingsStore';\r\n\r\ninterface ClassSelectionProps {\r\n    onSelectClass: (className: string) => void;\r\n    onNavigate: (view: View) => void;\r\n}\r\n\r\nconst ClassSelection: React.FC<ClassSelectionProps> = ({ onSelectClass, onNavigate }) => {\r\n    const students = useStudentStore(state => state.students);\r\n    const evaluations = useStudentStore(state => state.evaluations);\r\n    const competencyEvaluations = useStudentStore(state => state.competencyEvals);\r\n    const settings = useSettingsStore(state => state.settings);\r\n    const userClasses = settings.classi || [];\r\n\r\n    const [isPrintCenterOpen, setIsPrintCenterOpen] = useState(false);\r\n\r\n    // --- LOGIC: Upcoming Tests (Cross-Class) ---\r\n    const upcomingTests = useMemo(() => {\r\n        const today = new Date();\r\n        today.setHours(0, 0, 0, 0);\r\n\r\n        return evaluations\r\n            .filter(e => {\r\n                const evalDate = new Date(e.data);\r\n                return evalDate >= today;\r\n            })\r\n            .sort((a, b) => new Date(a.data).getTime() - new Date(b.data).getTime())\r\n            .reduce((acc, curr) => {\r\n                const key = `${String(curr.data)}-${String(curr.materia)}-${String(curr.tipo)}`;\r\n                if (!acc.some(i => `${String(i.data)}-${String(i.materia)}-${String(i.tipo)}` === key)) {\r\n                    const student = students.find(s => s.id === curr.studenteId);\r\n                    if (student) {\r\n                        acc.push({ ...curr, className: student.classe });\r\n                    }\r\n                }\r\n                return acc;\r\n            }, [] as (Valutazione & { className: string })[])\r\n            .slice(0, 3); // Take top 3\r\n    }, [evaluations, students]);\r\n\r\n    return (\r\n        <div className=\"page-layout pb-24\">\r\n             {/* Header Section */}\r\n            <div className=\"page-header-compact\">\r\n                <div className=\"page-header-title-group\">\r\n                    <h1 className=\"m3-headline-medium text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"900\" }}>Le Mie Classi</h1>\r\n                    <p className=\"page-subtitle text-[var(--md-sys-color-on-surface)]-variant\">Gestione studenti e analisi.</p>\r\n                </div>\r\n            </div>\r\n\r\n            {/* --- GLOBAL AGENDA WIDGET --- */}\r\n            {upcomingTests.length > 0 && (\r\n                <section className=\"animate-in fade-in slide-in-from-top-4\">\r\n                    <h2 className=\"section-header-expressive !mb-8 text-[var(--md-sys-color-on-surface)]-variant\" style={{ fontSize: \"0.875rem\", textTransform: \"uppercase\", letterSpacing: \"0.05em\" }}>\r\n                        In Arrivo (Tutte le classi)\r\n                    </h2>\r\n                    <div className=\"global-agenda-grid\">\r\n                        {upcomingTests.map((test, idx) => (\r\n                            <div key={idx} className=\"agenda-event-card\">\r\n                                <div>\r\n                                    <span className=\"agenda-event-date\">{new Date(test.data).toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short' })}</span>\r\n                                    <h4 className=\"agenda-event-title\">{test.materia}</h4>\r\n                                    <p className=\"agenda-event-subtitle max-w-[120px] md:max-w-[150px]\" style={{ overflow: \"hidden\", textOverflow: \"ellipsis\", whiteSpace: \"nowrap\" }}>{test.argomento || test.tipo}</p>\r\n                                </div>\r\n                                <div className=\"agenda-event-class\">{test.className}</div>\r\n                            </div>\r\n                        ))}\r\n                    </div>\r\n                </section>\r\n            )}\r\n\r\n            {/* Section 1: Classes Grid (New Widget Style) */}\r\n            <section>\r\n                 <SectionHeader \r\n                    title=\"Classi Attive\" \r\n                    icon=\"school\"\r\n                />\r\n                \r\n                {userClasses.length > 0 ? (\r\n                    <div className=\"expressive-grid\">\r\n                        {userClasses.map((className) => {\r\n                            const classStudents = students.filter(s => s.classe === className);\r\n                            const studentCount = classStudents.length;\r\n                            const studentAverages = classStudents.map(s => {\r\n                                const sEvals = evaluations.filter(e => e.studenteId === s.id);\r\n                                const { grade } = calculatePerformance(s.id, 'Complessivo', sEvals);\r\n                                const numGrade = grade ? parseFloat(grade) : null;\r\n                                return numGrade;\r\n                            }).filter((v): v is number => v !== null);\r\n                            const classAverage = studentAverages.length > 0 \r\n                                ? (studentAverages.reduce((a, b) => a + b, 0) / studentAverages.length).toFixed(1)\r\n                                : '-';\r\n                            return (\r\n                                <M3ExpressiveCard\r\n                                    key={className}\r\n                                    icon=\"groups\"\r\n                                    title={className}\r\n                                    description={`${studentCount} studenti | Media: ${classAverage}`}\r\n                                    color=\"primary\"\r\n                                    onClick={() => onSelectClass(className)}\r\n                                />\r\n                            );\r\n                        })}\r\n                    </div>\r\n                ) : (\r\n                    <div className=\"p-12 bg-[var(--md-sys-color-surface-container-low)] rounded-[var(--md-sys-shape-corner-large)] border-dashed border-[var(--md-sys-color-outline-variant)]\" style={{ textAlign: \"center\", border: \"1px solid var(--md-sys-color-outline)\" }}>\r\n                        <span className=\"material-symbols-outlined text-6xl text-[var(--md-sys-color-on-surface)]-variant/50\" style={{ marginBottom: \"var(--md-sys-spacing-8)\" }}>domain_disabled</span>\r\n                        <p className=\"text-[var(--md-sys-typescale-headline-small)] font-[var(--md-sys-typescale-headline-small-font)] text-[var(--md-sys-color-on-surface)]-variant\">Nessuna classe definita</p>\r\n                        <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] text-[var(--md-sys-color-on-surface)]-variant\" style={{ marginTop: \"var(--md-sys-spacing-4)\", marginBottom: \"var(--md-sys-spacing-6)\" }}>\r\n                            Vai nelle impostazioni per configurare le tue classi e iniziare.\r\n                        </p>\r\n                        <M3Button onClick={() => onNavigate('settings')} variant=\"filled\">\r\n                            Vai a Impostazioni\r\n                        </M3Button>\r\n                    </div>\r\n                )}\r\n            </section>\r\n\r\n            {/* Section 2: Global Tools */}\r\n            <section>\r\n                 <SectionHeader \r\n                    title=\"Gestione Rapida\" \r\n                    icon=\"settings_applications\"\r\n                />\r\n                \r\n                <div className=\"expressive-grid\">\r\n                    <button \r\n                        onClick={() => onNavigate('studenti')} \r\n                        className=\"expressive-tool-card variant-secondary\"\r\n                    >\r\n                        <span className=\"material-symbols-outlined tool-icon\">group_add</span>\r\n                        <span className=\"tool-title\">Importazione Massiva</span>\r\n                        <span className=\"tool-subtitle\">Carica studenti da CSV</span>\r\n                    </button>\r\n\r\n                    <button \r\n                        onClick={() => setIsPrintCenterOpen(true)} \r\n                        className=\"expressive-tool-card variant-primary\"\r\n                    >\r\n                        <span className=\"material-symbols-outlined tool-icon\">print</span>\r\n                        <span className=\"tool-title\">Centro Stampe</span>\r\n                        <span className=\"tool-subtitle\">Report PDF multi-classe</span>\r\n                    </button>\r\n\r\n                    <button \r\n                        onClick={() => onNavigate('analytics')} \r\n                        className=\"expressive-tool-card variant-tertiary\"\r\n                    >\r\n                        <span className=\"material-symbols-outlined tool-icon\">analytics</span>\r\n                        <span className=\"tool-title\">Analytics Hub</span>\r\n                        <span className=\"tool-subtitle\">Dashboard dati avanzata</span>\r\n                    </button>\r\n\r\n                    <button \r\n                        onClick={() => onNavigate('didattica-inclusiva')} \r\n                        className=\"expressive-tool-card variant-surface\"\r\n                    >\r\n                        <span className=\"material-symbols-outlined tool-icon\" style={{ color: \"var(--md-sys-color-tertiary)\" }}>accessibility_new</span>\r\n                        <span className=\"tool-title\">Didattica Inclusiva</span>\r\n                        <span className=\"tool-subtitle\">Gestione PEI/PDP globale</span>\r\n                    </button>\r\n                </div>\r\n            </section>\r\n\r\n            {/* INTERNAL MODAL: PRINT CENTER */}\r\n            {isPrintCenterOpen && (\r\n                <PrintCenterModal \r\n                    userClasses={userClasses}\r\n                    onClose={() => setIsPrintCenterOpen(false)}\r\n                    students={students}\r\n                    evaluations={evaluations}\r\n                    competencyEvaluations={competencyEvaluations}\r\n                    settings={settings}\r\n                />\r\n            )}\r\n        </div>\r\n    );\r\n};\r\n\r\n// --- Sub-component: Print Center Modal ---\r\nconst PrintCenterModal: React.FC<{ \r\n    userClasses: string[]; \r\n    onClose: () => void;\r\n    students: Studente[];\r\n    evaluations: Valutazione[];\r\n    competencyEvaluations: ValutazioneCompetenza[];\r\n    settings: TimetableSettings;\r\n}> = ({ userClasses, onClose, students, evaluations, competencyEvaluations, settings }) => {\r\n    const [selectedClasses, setSelectedClasses] = useState<string[]>([]);\r\n    const [periodo, setPeriodo] = useState<PeriodoValutazione>('primo-quadrimestre');\r\n    const [isProcessing, setIsProcessing] = useState(false);\r\n\r\n    const toggleClass = (c: string) => {\r\n        setSelectedClasses(prev => prev.includes(c) ? prev.filter(k => k !== c) : [...prev, c]);\r\n    };\r\n\r\n    const handlePrintAll = async () => {\r\n        if (selectedClasses.length === 0) return;\r\n        setIsProcessing(true);\r\n        try {\r\n            for (const className of selectedClasses) {\r\n                const classStudents = students.filter(s => s.classe === className);\r\n                const blob = await generateCouncilDataPdf(\r\n                    className,\r\n                    periodo,\r\n                    classStudents,\r\n                    evaluations,\r\n                    competencyEvaluations,\r\n                    settings\r\n                );\r\n                // FIX DEFINITIVO: String() per il periodo nel nome file\r\n                saveAs(blob, `Report_Consiglio_${String(className)}_${String(periodo)}.pdf`);\r\n                // Small delay to allow download initiation\r\n                await new Promise(r => setTimeout(r, 800));\r\n            }\r\n        } catch(e) {\r\n            console.error(e);\r\n        } finally {\r\n            setIsProcessing(false);\r\n            onClose();\r\n        }\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            title=\"Centro Stampe\"\r\n            onClose={onClose}\r\n            maxWidth=\"md\"\r\n        >\r\n            <M3DialogContent style={{ gap: \"var(--md-sys-spacing-6)\" }}>\r\n                    <p className=\"text-[var(--md-sys-color-on-surface)]-variant\">Seleziona le classi e il periodo per cui generare il prospetto voti (PDF).</p>\r\n                    \r\n                    <div style={{ gap: \"var(--md-sys-spacing-2)\" }}>\r\n                        <label className=\"text-[var(--md-sys-color-on-surface)]-variant ml-1\" style={{ fontSize: \"0.875rem\", fontWeight: \"500\" }}>Periodo</label>\r\n                        <TabGroup\r\n                            tabs={[\r\n                                { id: 'primo-quadrimestre', label: '1Q' },\r\n                                { id: 'secondo-quadrimestre', label: 'Finale' }\r\n                            ]}\r\n                            activeTab={periodo}\r\n                            onTabChange={(id) => setPeriodo(id as PeriodoValutazione)}\r\n                        />\r\n                    </div>\r\n\r\n                    <div style={{ gap: \"var(--md-sys-spacing-2)\" }}>\r\n                        <label className=\"text-[var(--md-sys-color-on-surface)]-variant ml-1\" style={{ fontSize: \"0.875rem\", fontWeight: \"500\" }}>Classi</label>\r\n                        <div style={{ display: \"flex\", flexWrap: \"wrap\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                            {userClasses.map(c => (\r\n                                <div \r\n                                    key={c} \r\n                                    onClick={() => toggleClass(c)}\r\n                                    className={`px-4 py-4 rounded-full border cursor-pointer transition-all flex items-center gap-8 ${\r\n                                        selectedClasses.includes(c) \r\n                                            ? 'bg-primary text-on-primary border-primary' \r\n                                            : 'bg-[var(--md-sys-color-surface-container-low)] text-[var(--md-sys-color-on-surface)]-variant border-[var(--md-sys-color-outline-variant)] hover:bg-[var(--md-sys-color-surface-container-high)]'\r\n                                    }`}\r\n                                >\r\n                                    {selectedClasses.includes(c) && <span className=\"material-symbols-outlined\" style={{ fontSize: \"1.125rem\" }}>check</span>}\r\n                                    Classe {c}\r\n                                </div>\r\n                            ))}\r\n                        </div>\r\n                    </div>\r\n            </M3DialogContent>\r\n            <M3DialogActions>\r\n                <M3Button onClick={onClose} variant=\"text\">Annulla</M3Button>\r\n                <M3Button onClick={handlePrintAll} disabled={selectedClasses.length === 0 || isProcessing} variant=\"filled\">\r\n                    {isProcessing ? 'Elaborazione...' : `Genera ${selectedClasses.length} PDF`}\r\n                </M3Button>\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    )\r\n}\r\n\r\nexport default React.memo(ClassSelection);\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ClassroomTools.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":43,"column":14,"nodeType":"JSXAttribute","endLine":43,"endColumn":54},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":49,"column":18,"nodeType":"JSXAttribute","endLine":49,"endColumn":58},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed 