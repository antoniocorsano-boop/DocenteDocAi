ind-classes","severity":2,"message":"Tailwind class 'border-white/10' not allowed. Use MD3 tokens in inline styles.","line":226,"column":38,"nodeType":"JSXAttribute","endLine":226,"endColumn":173},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":227,"column":91,"nodeType":"JSXAttribute","endLine":227,"endColumn":117},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":239,"column":41,"nodeType":"JSXAttribute","endLine":239,"endColumn":92},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level2)]' not allowed. Use MD3 tokens in inline styles.","line":239,"column":41,"nodeType":"JSXAttribute","endLine":239,"endColumn":92},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":246,"column":34,"nodeType":"JSXAttribute","endLine":246,"endColumn":129},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant/20' not allowed. Use MD3 tokens in inline styles.","line":246,"column":34,"nodeType":"JSXAttribute","endLine":246,"endColumn":129},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":248,"column":36,"nodeType":"JSXAttribute","endLine":248,"endColumn":79},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":254,"column":34,"nodeType":"JSXAttribute","endLine":254,"endColumn":146},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-gradient-to-br' not allowed. Use MD3 tokens in inline styles.","line":254,"column":34,"nodeType":"JSXAttribute","endLine":254,"endColumn":146},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":286,"column":18,"nodeType":"JSXAttribute","endLine":286,"endColumn":107},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-[var(--md-sys-color-surface-container-low)]est/50' not allowed. Use MD3 tokens in inline styles.","line":286,"column":18,"nodeType":"JSXAttribute","endLine":286,"endColumn":107},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":288,"column":22,"nodeType":"JSXAttribute","endLine":288,"endColumn":141},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'w-[40%]' not allowed. Use MD3 tokens in inline styles.","line":288,"column":22,"nodeType":"JSXAttribute","endLine":288,"endColumn":141},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'h-[40%]' not allowed. Use MD3 tokens in inline styles.","line":288,"column":22,"nodeType":"JSXAttribute","endLine":288,"endColumn":141},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-primary/5' not allowed. Use MD3 tokens in inline styles.","line":288,"column":22,"nodeType":"JSXAttribute","endLine":288,"endColumn":141},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":289,"column":22,"nodeType":"JSXAttribute","endLine":289,"endColumn":147},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'w-[40%]' not allowed. Use MD3 tokens in inline styles.","line":289,"column":22,"nodeType":"JSXAttribute","endLine":289,"endColumn":147},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'h-[40%]' not allowed. Use MD3 tokens in inline styles.","line":289,"column":22,"nodeType":"JSXAttribute","endLine":289,"endColumn":147},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-secondary/5' not allowed. Use MD3 tokens in inline styles.","line":289,"column":22,"nodeType":"JSXAttribute","endLine":289,"endColumn":147},{"ruleId":"react/jsx-no-duplicate-props","severity":2,"message":"No duplicate props allowed","line":289,"column":183,"nodeType":"JSXAttribute","messageId":"noDuplicateProps","endLine":289,"endColumn":215},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":291,"column":22,"nodeType":"JSXAttribute","endLine":291,"endColumn":64}],"suppressedMessages":[],"errorCount":101,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\nimport React, { useState, useEffect } from 'react';\r\n// Load Google GenAI dynamically to avoid bundling it in the main chunk\r\nimport { M3Dialog, TextArea, M3Button } from './ui';\r\n\r\ninterface VideoAnalysisModalProps {\r\n    onClose: () => void;\r\n}\r\n\r\nconst loadingMessages = [\r\n    \"Inizializzazione del modello Veo...\",\r\n    \"Analisi del prompt in corso...\",\r\n    \"I fotogrammi stanno prendendo vita...\",\r\n    \"Renderizzazione del video ad alta definizione...\",\r\n    \"Quasi pronto, applicando gli ultimi ritocchi...\",\r\n];\r\n\r\nconst VideoAnalysisModal: React.FC<VideoAnalysisModalProps> = ({ onClose }) => {\r\n    const [hasApiKey, setHasApiKey] = useState<boolean | null>(null);\r\n    const [prompt, setPrompt] = useState<string>('');\r\n    const [isLoading, setIsLoading] = useState<boolean>(false);\r\n    const [loadingMessage, setLoadingMessage] = useState<string>(loadingMessages[0]);\r\n    const [error, setError] = useState<string>('');\r\n    const [generatedVideoUrl, setGeneratedVideoUrl] = useState<string | null>(null);\r\n\r\n    useEffect(() => {\r\n        // GUIDELINE: Use window.aistudio.hasSelectedApiKey() to check for selected key\r\n        if (window.aistudio) {\r\n            window.aistudio.hasSelectedApiKey().then(setHasApiKey);\r\n        } else {\r\n            // Check if injected via process.env\r\n            setHasApiKey(!!import.meta.env.VITE_GEMINI_API_KEY);\r\n        }\r\n    }, []);\r\n\r\n    useEffect(() => {\r\n        let interval: number;\r\n        if (isLoading) {\r\n            let i = 0;\r\n            interval = window.setInterval(() => {\r\n                i = (i + 1) % loadingMessages.length;\r\n                setLoadingMessage(loadingMessages[i]);\r\n            }, 5000);\r\n        }\r\n        return () => clearInterval(interval);\r\n    }, [isLoading]);\r\n\r\n    const handleSelectKey = async () => {\r\n        if (window.aistudio) {\r\n            await window.aistudio.openSelectKey();\r\n            // GUIDELINE: MUST assume key selection was successful after triggering openSelectKey()\r\n            setHasApiKey(true);\r\n        } else {\r\n            alert(\"Per favore configura l'API Key nel tuo ambiente.\");\r\n        }\r\n    };\r\n\r\n    const handleSubmit = async () => {\r\n        if (!prompt) {\r\n            setError(\"Per favore, inserisci un prompt per generare il video.\");\r\n            return;\r\n        }\r\n        setError('');\r\n        setIsLoading(true);\r\n        setGeneratedVideoUrl(null);\r\n        setLoadingMessage(loadingMessages[0]);\r\n\r\n        try {\r\n            // GUIDELINE: Create new GoogleGenAI instance right before call (lazy-loaded)\r\n            const genaiModule = await import('@google/genai');\r\n            const GoogleGenAI = genaiModule.GoogleGenAI;\r\n            const ai = new GoogleGenAI(import.meta.env.VITE_GEMINI_API_KEY);\r\n\r\n            // Veo model parameters\r\n            let operation = await ai.models.generateVideos({\r\n                model: 'veo-3.1-fast-generate-preview',\r\n                prompt: prompt,\r\n                config: {\r\n                    numberOfVideos: 1,\r\n                    resolution: '720p',\r\n                    aspectRatio: '16:9'\r\n                }\r\n            });\r\n\r\n            while (!operation.done) {\r\n                await new Promise(resolve => setTimeout(resolve, 10000));\r\n                operation = await ai.operations.getVideosOperation({ operation });\r\n            }\r\n\r\n            if (operation.error) {\r\n                // GUIDELINE: Reset key if \"Requested entity was not found\" error occurs\r\n                const errorMessage = typeof operation.error.message === 'string' ? operation.error.message : 'Errore durante la generazione del video.';\r\n                if (errorMessage.includes(\"Requested entity was not found.\")) {\r\n                    setError(\"API Key non valida o permessi mancanti. Per favore, seleziona nuovamente la chiave.\");\r\n                    setHasApiKey(false);\r\n                    return;\r\n                }\r\n                throw new Error(errorMessage);\r\n            }\r\n\r\n            const downloadLink = operation.response?.generatedVideos?.[0]?.video?.uri;\r\n\r\n            if (downloadLink) {\r\n                // GUIDELINE: Append API key when fetching from download link\r\n                const urlWithKey = `${downloadLink}&key=${import.meta.env.VITE_GEMINI_API_KEY}`;\r\n                const response = await fetch(urlWithKey);\r\n                if (!response.ok) {\r\n                    throw new Error(`Errore nel download del video: ${response.statusText}`);\r\n                }\r\n                const videoBlob = await response.blob();\r\n                const videoUrl = URL.createObjectURL(videoBlob);\r\n                setGeneratedVideoUrl(videoUrl);\r\n            } else {\r\n                throw new Error(\"Nessun link per il download del video trovato nella risposta.\");\r\n            }\r\n\r\n        } catch (err: unknown) {\r\n            console.error(\"Error during video generation:\", err);\r\n            const errorMessage = (err instanceof Error) ? err.message : String(err);\r\n            setError(`Errore durante la generazione: ${errorMessage}`);\r\n        } finally {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    const renderContent = () => {\r\n        if (hasApiKey === null) {\r\n            return (\r\n                <div className=\"p-20\" style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", justifyContent: \"center\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                    <div className=\"relative\">\r\n                        <div className=\"border-4 border-primary/20 border-t-primary animate-spin\" style={{ width: \"5rem\", height: \"5rem\", borderRadius: \"9999px\" }}></div>\r\n                        <div className=\"absolute inset-0\" style={{ display: \"flex\", alignItems: \"center\", justifyContent: \"center\" }}>\r\n                            <span className=\"material-symbols-outlined animate-pulse\" style={{ color: \"var(--md-sys-color-primary)\" }}>movie</span>\r\n                        </div>\r\n                    </div>\r\n                    <p className=\"m3-label-large tracking-[0.3em] animate-pulse\" style={{ fontWeight: \"900\", textTransform: \"uppercase\", opacity: \"0.4\" }}>Inizializzazione...</p>\r\n                </div>\r\n            );\r\n        }\r\n\r\n        if (!hasApiKey) {\r\n            return (\r\n                <div className=\"p-12 bg-[var(--md-sys-color-surface-container-low)]/30 backdrop-blur-xl rounded-5xl border-[var(--md-sys-color-outline-variant)]/20 shadow-[var(--md-sys-elevation-level4)] max-w-2xl mt-10 animate-in zoom-in-95 duration-500\" style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\", justifyContent: \"center\", textAlign: \"center\", border: \"1px solid var(--md-sys-color-outline)\", marginLeft: \"auto\", 