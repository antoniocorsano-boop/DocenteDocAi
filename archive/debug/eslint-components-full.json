lasses","severity":2,"message":"Tailwind class 'border-error' not allowed. Use MD3 tokens in inline styles.","line":177,"column":25,"nodeType":"JSXAttribute","endLine":177,"endColumn":65},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":184,"column":45,"nodeType":"JSXAttribute","endLine":184,"endColumn":94},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]' not allowed. Use MD3 tokens in inline styles.","line":184,"column":45,"nodeType":"JSXAttribute","endLine":184,"endColumn":94},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":185,"column":44,"nodeType":"JSXAttribute","endLine":185,"endColumn":101},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":185,"column":44,"nodeType":"JSXAttribute","endLine":185,"endColumn":101},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":188,"column":38,"nodeType":"JSXAttribute","endLine":188,"endColumn":66},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-error/10' not allowed. Use MD3 tokens in inline styles.","line":188,"column":38,"nodeType":"JSXAttribute","endLine":188,"endColumn":66},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":192,"column":32,"nodeType":"JSXAttribute","endLine":192,"endColumn":89},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":192,"column":32,"nodeType":"JSXAttribute","endLine":192,"endColumn":89},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":198,"column":33,"nodeType":"JSXAttribute","endLine":198,"endColumn":88},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":207,"column":22,"nodeType":"JSXAttribute","endLine":207,"endColumn":47},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":219,"column":14,"nodeType":"JSXAttribute","endLine":219,"endColumn":53},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'max-w-7xl' not allowed. Use MD3 tokens in inline styles.","line":219,"column":14,"nodeType":"JSXAttribute","endLine":219,"endColumn":53},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":223,"column":17,"nodeType":"JSXAttribute","endLine":223,"endColumn":34},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":245,"column":22,"nodeType":"JSXAttribute","endLine":245,"endColumn":47},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'min-h-[400px]' not allowed. Use MD3 tokens in inline styles.","line":245,"column":22,"nodeType":"JSXAttribute","endLine":245,"endColumn":47}],"suppressedMessages":[],"errorCount":50,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo, useEffect } from 'react';\r\nimport { Studente, DidatticaInclusivaProps } from '../types';\r\nimport PianoInclusioneEditor from './PianoInclusioneEditor';\r\nimport { calculatePerformance } from '../utils/evaluationUtils';\r\nimport { \r\n    InfoCard, \r\n    EmptyState, \r\n    TabGroup, \r\n    SectionHeader, \r\n    M3Button,\r\n    Avatar \r\n} from './ui';\r\n\r\nconst DidatticaInclusiva: React.FC<DidatticaInclusivaProps> = (props) => {\r\n    const { students, pianiInclusione, onSavePiano, studentToEdit, onClearStudentToEdit, evaluations } = props;\r\n    const [editingStudent, setEditingStudent] = useState<Studente | null>(null);\r\n    const [activeTab, setActiveTab] = useState<'overview' | 'active' | 'suggested'>('overview');\r\n\r\n    useEffect(() => {\r\n        if (studentToEdit) {\r\n            setEditingStudent(studentToEdit);\r\n        }\r\n    }, [studentToEdit]);\r\n\r\n    const handleCloseEditor = () => {\r\n        setEditingStudent(null);\r\n        if (onClearStudentToEdit) {\r\n            onClearStudentToEdit();\r\n        }\r\n    };\r\n\r\n    const studentsByClass = useMemo(() => {\r\n        return students.reduce((acc, student) => {\r\n            (acc[student.classe] = acc[student.classe] || []).push(student);\r\n            return acc;\r\n        }, {} as Record<string, Studente[]>);\r\n    }, [students]);\r\n\r\n    const activePlansStudents = useMemo(() => {\r\n        return students.filter(s => !!pianiInclusione[s.id]);\r\n    }, [students, pianiInclusione]);\r\n\r\n    const suggestedStudents = useMemo(() => {\r\n        return students.filter(s => {\r\n            const hasPlan = !!pianiInclusione[s.id];\r\n            if (hasPlan) return false;\r\n            const studentEvals = evaluations.filter(e => e.studenteId === s.id);\r\n            const { grade } = calculatePerformance(s.id, 'Complessivo', studentEvals);\r\n            return grade && parseFloat(grade) < 6;\r\n        });\r\n    }, [students, pianiInclusione, evaluations]);\r\n\r\n    const sortedClasses = Object.keys(studentsByClass).sort();\r\n\r\n    const renderOverview = () => (\r\n        <div style={{\r\n  marginTop: 'var(--md-sys-spacing-8)'\r\n}}>\r\n            <InfoCard\r\n                variant=\"tertiary\"\r\n                style={{ padding: 'var(--md-sys-spacing-5)' }}\r\n            >\r\n                <div style={{ display: \"flex\", alignItems: \"flex-start\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                    <div className=\"rounded-[var(--md-sys-shape-corner-large)] bg-tertiary/10 shrink-0\" style={{ width: \"3rem\", height: \"3rem\", display: \"flex\", alignItems: \"center\", justifyContent: \"center\", color: \"var(--md-sys-color-tertiary)\" }}>\r\n                        <span className=\"material-symbols-outlined text-3xl\">folder_shared</span>\r\n                    </div>\r\n                    <div>\r\n                        <h3 className=\"font-semibold\" style={{ fontSize: \"1.125rem\", color: \"var(--md-sys-color-tertiary)\", marginBottom: \"var(--md-sys-spacing-4)\" }}>Gestione Piani Centralizzata</h3>\r\n                        <p className=\"text-[var(--md-sys-color-on-surface)]-variant\">Crea o modifica PDP/PEI per ogni studente. LÔÇÖAI ti guida nella compilazione suggerendo strategie personalizzate.</p>\r\n                    </div>\r\n                </div>\r\n            </InfoCard>\r\n\r\n            {sortedClasses.map(className => (\r\n                <div key={className} style={{\r\n  marginTop: 'var(--md-sys-spacing-4)'\r\n}}>\r\n                    <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\", paddingLeft: \"var(--md-sys-spacing-4)\", paddingRight: \"var(--md-sys-spacing-4)\" }}>\r\n                        <div className=\"h-px bg-outline-variant/30\" style={{ flexGrow: \"1\" }}></div>\r\n                        <span className=\"text-[var(--md-sys-color-on-surface)]-variant/60\" style={{ fontSize: \"0.875rem\", fontWeight: \"bold\", textTransform: \"uppercase\", letterSpacing: \"0.1em\" }}>Classe {className}</span>\r\n                        <div className=\"h-px bg-outline-variant/30\" style={{ flexGrow: \"1\" }}></div>\r\n                    </div>\r\n                    \r\n                    <div className=\"md:grid-cols-2 lg:grid-cols-3\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                        {studentsByClass[className].sort((a, b) => a.cognome.localeCompare(b.cognome)).map(student => {\r\n                            const hasPlan = !!pianiInclusione[student.id];\r\n\r\n                            return (\r\n                                <InfoCard \r\n                                    key={student.id} \r\n                                    variant=\"elevated\"\r\n                                    className=\"group hover:ring-2 hover:ring-primary/20\" style={{ transition: \"all 300ms cubic-bezier(0.4, 0, 0.2, 1)\", cursor: \"pointer\" }}\r\n                                    onClick={() => setEditingStudent(student)}\r\n                                >\r\n                                    <div style={{ padding: \"var(--md-sys-spacing-8)\", display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                                        <Avatar name={`${student.nome} ${student.cognome}`} size=\"md\" />\r\n                                        <div style={{ flexGrow: \"1\", minWidth: \"0\" }}>\r\n                                            <p className=\"text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"bold\", overflow: \"hidden\", textOverflow: \"ellipsis\", whiteSpace: \"nowrap\" }}>{student.cognome} {student.nome}</p>\r\n                                            <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\", marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                                                {hasPlan ? (\r\n                                                    <span className=\"m3-label-tiny bg-tertiary-container/50 py-0.5\" style={{ fontWeight: \"bold\", textTransform: \"uppercase\", letterSpacing: \"0.05em\", color: \"var(--md-sys-color-tertiary)\", paddingLeft: \"var(--md-sys-spacing-4)\", paddingRight: \"var(--md-sys-spacing-4)\", borderRadius: \"9999px\" }}>\r\n                                                        Piano Attivo\r\n                                                    </span>\r\n                                                ) : (\r\n                                                    <span className=\"m3-label-tiny text-[var(--md-sys-color-on-surface)]-variant/40 py-0.5 border-[var(--md-sys-color-outline-variant)]/30\" style={{ fontWeight: \"bold\", textTransform: \"uppercase\", letterSpacing: \"0.05em\", paddingLeft: \"var(--md-sys-spacing-4)\", paddingRight: \"var(--md-sys-spacing-4)\", border: \"1px solid var(--md-sys-color-outline)\", borderRadius: \"9999px\" }}>\r\n                                                        Standard\r\n                                                    </span>\r\n                                                )}\r\n                                            </div>\r\n                                        </div>\r\n                                        <div className={`w-10 h-10 rounded-full flex items-center justify-center transition-colors ${hasPlan ? 'bg-tertiary/10 text-tertiary' : 'bg-[var(--md-sys-color-surface-container-high)] text-[var(--md-sys-color-on-surface)]-variant group-hover:bg-primary/10 group-hover:text-primary'}`}>\r\n                                            <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}}>{hasPlan ? 'edit' : 'add'}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                </InfoCard>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            ))}\r\n            {students.length === 0 && (\r\n                <EmptyState\r\n                    title=\"Nessuno studente\"\r\n                    description=\"Aggiungi i tuoi studenti dalla sezione Classi per iniziare a gestire l'inclusione.\"\r\n                    icon=\"group_off\"\r\n                />\r\n            )}\r\n        </div>\r\n    );\r\n\r\n    const renderActivePlans = () => (\r\n        <div className=\"md:grid-cols-2\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n            {activePlansStudents.length > 0 ? activePlansStudents.map(student => {\r\n                return (\r\n                    <InfoCard \r\n                        key={student.id} \r\n                        variant=\"tonal\"\r\n                        className=\"hover:ring-2 hover:ring-primary/20\" style={{ padding: \"var(--md-sys-spacing-8)\", transition: \"all 300ms cubic-bezier(0.4, 0, 0.2, 1)\", cursor: \"pointer\" }}\r\n                        onClick={() => setEditingStudent(student)}\r\n                    >\r\n                        <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                            <Avatar name={`${student.nome} ${student.cognome}`} size=\"md\" />\r\n                            <div style={{ flexGrow: \"1\" }}>\r\n                                <h3 className=\"text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"bold\" }}>{student.cognome} {student.nome}</h3>\r\n                                <p className=\"text-[var(--md-sys-color-on-surface)]-variant\" style={{ fontSize: \"0.875rem\" }}>Classe {student.classe}</p>\r\n                            </div>\r\n                            <M3Button variant=\"text\" size=\"small\">\r\n                                Modifica\r\n                            </M3Button>\r\n                        </div>\r\n                    </InfoCard>\r\n                )\r\n            }) : (\r\n                <div className=\"col-span-full\">\r\n                    <EmptyState\r\n                        title=\"Nessun piano attivo\"\r\n                        description=\"Non hai ancora creato nessun PDP o PEI.\"\r\n                        icon=\"folder_off\"\r\n                    />\r\n                </div>\r\n            )}\r\n        </div>\r\n    );\r\n\r\n    const renderSuggested = () => (\r\n        <div className=\"md:grid-cols-2 lg:grid-cols-3\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n            {suggestedStudents.length > 0 ? suggestedStudents.map(student => {\r\n                const studentEvals = evaluations.filter(e => e.studenteId === student.id);\r\n                const { grade } = calculatePerformance(student.id, 'Complessivo', studentEvals);\r\n\r\n                return (\r\n                    <InfoCard \r\n                        key={student.id} \r\n                        variant=\"elevated\"\r\n                        className=\"overflow-hidden border-error\" style={{ borderLeft: \"4px solid\" }}\r\n                    >\r\n                        <div style={{ padding: 'var(--md-sys-spacing-4)' }}>\r\n                            <div style={{ display: \"flex\", alignItems: \"flex-start\", justifyContent: \"space-between\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                                <div style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-6)\" }}>\r\n                                    <Avatar name={`${student.nome} ${student.cognome}`} size=\"md\" />\r\n                                    <div>\r\n                                        <h3 className=\"text-[var(--md-sys-color-on-surface)]\" style={{ fontWeight: \"bold\" }}>{student.cognome} {student.nome}</h3>\r\n                                        <p className=\"text-[var(--md-sys-color-on-surface)]-variant\" style={{ fontSize: \"0.75rem\" }}>Classe {student.classe}</p>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"bg-error/10 py-1\" style={{ color: \"var(--md-sys-color-error)\", paddingLeft: \"var(--md-sys-spacing-4)\", paddingRight: \"var(--md-sys-spacing-4)\", borderRadius: \"0.375rem\", fontSize: \"0.75rem\", fontWeight: \"bold\" }}>\r\n                                    Media: {grade}\r\n                                </div>\r\n                            </div>\r\n                            <p className=\"text-[var(--md-sys-color-on-surface)]-variant\" style={{ fontSize: \"0.875rem\", marginBottom: \"var(--md-sys-spacing-8)\" }}>\r\n                                Le performance recenti suggeriscono la necessit´┐¢ di un piano personalizzato.\r\n                            </p>\r\n                            <M3Button \r\n                                onClick={() => setEditingStudent(student)} \r\n                                variant=\"tonal\"\r\n                                className=\"!bg-error/10 !text-error hover:!bg-error/20\" style={{ width: \"100%\" }}\r\n                            >\r\n                                <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\" }}>add_circle</span>\r\n                                Crea Piano\r\n                            </M3Button>\r\n                        </div>\r\n                    </InfoCard>\r\n                )\r\n            }) : (\r\n                <div className=\"col-span-full\">\r\n                    <EmptyState\r\n                        title=\"Tutto sotto controllo\"\r\n                        description=\"Non ci sono studenti con media insufficiente sprovvisti di piano.\"\r\n                        icon=\"check_circle\"\r\n                    />\r\n                </div>\r\n            )}\r\n        </div>\r\n    );\r\n\r\n    return (\r\n        <div className=\"page-layout max-w-7xl pb-24\" style={{ marginLeft: \"auto\", marginRight: \"auto\", width: \"100%\", paddingLeft: \"var(--md-sys-spacing-4)\", paddingRight: \"var(--md-sys-spacing-4)\" }}>\r\n            <SectionHeader \r\n                title=\"Didattica Inclusiva\"\r\n                subtitle=\"Piani personalizzati (PDP/PEI) e monitoraggio assistito dall'AI\"\r\n                className=\"py-12\" style={{ textAlign: \"center\" }}\r\n            />\r\n\r\n            <div style={{\r\n  marginTop: 'var(--md-sys-spacing-8)'\r\n}}>\r\n                <div style={{\r\n  display: 'flex',\r\n  justifyContent: 'center'\r\n}}>\r\n                    <TabGroup\r\n                        activeTab={activeTab}\r\n                        onTabChange={(id) => setActiveTab(id)}\r\n                        variant=\"primary\"\r\n                        tabs={[\r\n                            { id: 'overview', label: 'Panoramica', icon: 'grid_view' },\r\n                            { id: 'active', label: 'Piani Attivi', icon: 'description', badge: activePlansStudents.length > 0 ? activePlansStudents.length : undefined },\r\n                            { id: 'suggested', label: 'Da Attenzionare', icon: 'warning', badge: suggestedStudents.length > 0 ? suggestedStudents.length : undefined }\r\n                        ]}\r\n                    />\r\n                </div>\r\n\r\n                <div className=\"min-h-[400px]\">\r\n                    {activeTab === 'overview' && renderOverview()}\r\n                    {activeTab === 'active' && renderActivePlans()}\r\n                    {activeTab === 'suggested' && renderSuggested()}\r\n                </div>\r\n            </div>\r\n\r\n            {editingStudent && (\r\n                <PianoInclusioneEditor\r\n                    {...props}\r\n                    student={editingStudent}\r\n                    existingPiano={pianiInclusione[editingStudent.id]}\r\n                    onClose={handleCloseEditor}\r\n                    onSave={onSavePiano}\r\n                />\r\n            )}\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default DidatticaInclusiva;\r\n\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\DocumentGeneratorModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\DocumentViewerModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":59,"column":30,"nodeType":"JSXAttribute","endLine":59,"endColumn":58},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":61,"column":27,"nodeType":"JSXAttribute","endLine":61,"endColumn":43},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'h-64' not allowed. Use MD3 tokens in inline styles.","line":61,"column":27,"nodeType":"JSXAttribute","endLine":61,"endColumn":43},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":62,"column":30,"nodeType":"JSXAttribute","endLine":62,"endColumn":65},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-b-2' not allowed. Use MD3 tokens in inline styles.","line":62,"column":30,"nodeType":"JSXAttribute","endLine":62,"endColumn":65},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":66,"column":25,"nodeType":"JSXAttribute","endLine":66,"endColumn":104},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'max-w-none' not allowed. Use MD3 tokens in inline styles.","line":66,"column":25,"nodeType":"JSXAttribute","endLine":66,"endColumn":104},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":71,"column":30,"nodeType":"JSXAttribute","endLine":71,"endColumn":60},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'gap-12' not allowed. Use MD3 tokens in inline styles.","line":71,"column":30,"nodeType":"JSXAttribute","endLine":71,"endColumn":60},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":73,"column":71,"nodeType":"JSXAttribute","endLine":73,"endColumn":90}],"suppressedMessages":[],"errorCount":10,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\r\nimport { sanitizeHTML } from '../utils/securityUtils';\r\nimport { M3Dialog, M3DialogContent, M3DialogActions, M3Button } from './ui';\r\n\r\ninterface DocumentViewerModalProps {\r\n    title: string;\r\n    htmlContent: string;\r\n    onClose: () => void;\r\n    onSaveToKb?: (isFormattedDoc: boolean, data: { title: string, content: string, htmlContent: string }) => void;\r\n    onOpenCreateLesson?: (content: { title: string; htmlContent: string }) => void;\r\n}\r\n\r\nconst DocumentViewerModal: React.FC<DocumentViewerModalProps> = ({ title, htmlContent, onClose, onSaveToKb, onOpenCreateLesson }) => {\r\n    const [copyStatus, setCopyStatus] = useState<'idle' | 'copied'>('idle');\r\n\r\n    // Sanitize content before rendering to prevent XSS\r\n    const safeHtml = sanitizeHTML(htmlContent);\r\n\r\n    const handleCopyToClipboard = () => {\r\n        const tempDiv = document.createElement('div');\r\n        tempDiv.innerHTML = safeHtml;\r\n        const textContent = tempDiv.textContent || tempDiv.innerText || '';\r\n        navigator.clipboard.writeText(textContent).then(() => {\r\n            setCopyStatus('copied');\r\n            setTimeout(() => setCopyStatus('idle'), 2000);\r\n        }).catch(err => {\r\n            console.error('Failed to copy text: ', err);\r\n            alert('Impossibile copiare il testo.');\r\n        });\r\n    };\r\n\r\n    const handleSave = () => {\r\n        if (!onSaveToKb) return;\r\n        const tempDiv = document.createElement('div');\r\n        tempDiv.innerHTML = safeHtml;\r\n        const textContent = tempDiv.textContent || tempDiv.innerText || '';\r\n\r\n        onSaveToKb(true, {\r\n            title: title,\r\n            content: textContent,\r\n            htmlContent: safeHtml\r\n        });\r\n    };\r\n\r\n    const handleCreateLesson = () => {\r\n        if (onOpenCreateLesson) {\r\n            onOpenCreateLesson({ title, htmlContent: safeHtml });\r\n            onClose();\r\n        }\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            title={`Anteprima: ${title}`}\r\n            onClose={onClose}\r\n            maxWidth=\"xl\"\r\n            level={2}\r\n        >\r\n            <M3DialogContent className=\"px-12 pt-12 pb-0\">\r\n                {!safeHtml ? (\r\n                     <div className=\"h-64\" style={{ display: \"flex\", justifyContent: \"center\", alignItems: \"center\" }}>\r\n                        <div className=\"animate-spin border-b-2\" style={{ borderRadius: \"9999px\", height: \"3rem\", width: \"3rem\", borderColor: \"var(--md-sys-color-primary)\" }}></div>\r\n                    </div>\r\n                ) : (\r\n                    <div\r\n                        className=\"document-viewer-content prose prose-sm max-w-none dark:prose-invert\"\r\n                        dangerouslySetInnerHTML={{ __html: safeHtml }}\r\n                    />\r\n                )}\r\n            </M3DialogContent>\r\n            <M3DialogActions className=\"gap-12 px-12 pb-12\" style={{ paddingTop: \"0\" }}>\r\n                 {onSaveToKb && (\r\n                    <M3Button onClick={handleSave} variant=\"outlined\" className=\"mr-auto\">\r\n                        <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\" }}>save</span>\r\n                        Salva in KB\r\n                    </M3Button>\r\n                )}\r\n                <M3Button onClick={onClose} variant=\"text\">Chiudi</M3Button>\r\n                <M3Button onClick={handleCopyToClipboard} variant=\"tonal\">\r\n                     <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\" }}>{copyStatus === 'copied' ? 'check' : 'content_copy'}</span>\r\n                    {copyStatus === 'copied' ? 'Copiato!' : 'Copia Testo'}\r\n                </M3Button>\r\n                {onOpenCreateLesson && (\r\n                    <M3Button onClick={handleCreateLesson} variant=\"filled\">\r\n                         <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\" }}>add_task</span>\r\n                        Crea Lezione\r\n                    </M3Button>\r\n                )}\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default DocumentViewerModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\DraggableFab.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":110,"column":13,"nodeType":"JSXAttribute","endLine":110,"endColumn":43}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\n// M3Expressive refactor: Ô£à COMPLETED - Removed inline Tailwind classes, applied dedicated CSS classes with M3 tokens for colors, spacing, typography, elevation. Maintained responsive behavior and animations.\r\n// ...existing code...\r\n// ...existing code...\r\nimport React, { useState, useRef } from 'react';\r\n\r\ninterface DraggableFabProps {\r\n    onClick: () => void;\r\n    ariaLabel: string;\r\n}\r\n\r\nexport const DraggableFab: React.FC<DraggableFabProps> = ({ onClick, ariaLabel }) => {\r\n    // If position is null, it relies on CSS (bottom-right). Once set, it uses fixed top/left.\r\n    const [position, setPosition] = useState<{ top: number; left: number } | null>(null);\r\n    const buttonRef = useRef<HTMLButtonElement>(null);\r\n    const dragStartRef = useRef<{ x: number; y: number } | null>(null);\r\n    const initialPosRef = useRef<{ top: number; left: number } | null>(null);\r\n    const isDraggingRef = useRef(false);\r\n\r\n    const handlePointerDown = (e: React.PointerEvent) => {\r\n        const btn = buttonRef.current;\r\n        if (!btn) return;\r\n\r\n        // Prevent default to avoid text selection or weird touch behaviors\r\n        e.preventDefault();\r\n\r\n        const rect = btn.getBoundingClientRect();\r\n        \r\n        // Initialize position state on first drag if it hasn't been set yet\r\n        if (!position) {\r\n            const initialPos = { top: rect.top, left: rect.left };\r\n            setPosition(initialPos);\r\n            initialPosRef.current = initialPos;\r\n        } else {\r\n            initialPosRef.current = position;\r\n        }\r\n\r\n        dragStartRef.current = { x: e.clientX, y: e.clientY };\r\n        isDraggingRef.current = false;\r\n\r\n        // Attach global listeners to window to handle fast drags outside the button\r\n        window.addEventListener('pointermove', handlePointerMove);\r\n        window.addEventListener('pointerup', handlePointerUp);\r\n    };\r\n\r\n    const handlePointerMove = (e: PointerEvent) => {\r\n        if (!dragStartRef.current || !initialPosRef.current) return;\r\n\r\n        const deltaX = e.clientX - dragStartRef.current.x;\r\n        const deltaY = e.clientY - dragStartRef.current.y;\r\n\r\n        // Threshold to consider it a drag (prevents micro-movements preventing click)\r\n        if (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5) {\r\n            isDraggingRef.current = true;\r\n            // Disable transition during drag for instant response\r\n            if (buttonRef.current) buttonRef.current.style.transition = 'none';\r\n        }\r\n\r\n        if (isDraggingRef.current) {\r\n            let newTop = initialPosRef.current.top + deltaY;\r\n            let newLeft = initialPosRef.current.left + deltaX;\r\n\r\n            // Boundary checks\r\n            const btnSize = 64;\r\n            const margin = 8;\r\n            const maxTop = window.innerHeight - btnSize - margin;\r\n            const maxLeft = window.innerWidth - btnSize - margin;\r\n\r\n            newTop = Math.max(margin, Math.min(newTop, maxTop));\r\n            newLeft = Math.max(margin, Math.min(newLeft, maxLeft));\r\n\r\n            setPosition({ top: newTop, left: newLeft });\r\n        }\r\n    };\r\n\r\n    const handlePointerUp = () => {\r\n        window.removeEventListener('pointermove', handlePointerMove);\r\n        window.removeEventListener('pointerup', handlePointerUp);\r\n        \r\n        // Re-enable transition (if any defined in CSS for other props)\r\n        if (buttonRef.current) buttonRef.current.style.transition = '';\r\n        \r\n        dragStartRef.current = null;\r\n        initialPosRef.current = null;\r\n    };\r\n\r\n    const handleClick = (e: React.MouseEvent) => {\r\n        if (isDraggingRef.current) {\r\n            e.stopPropagation();\r\n            e.preventDefault();\r\n        } else {\r\n            onClick();\r\n        }\r\n    };\r\n\r\n    // Apply inline styles only when we have a custom position\r\n    const style: React.CSSProperties = position \r\n        ? { \r\n            top: `${position.top}px`, \r\n            left: `${position.left}px`, \r\n            bottom: 'auto', \r\n            right: 'auto',\r\n            position: 'fixed' \r\n          } \r\n        : {};\r\n\r\n    return (\r\n        <button\r\n            ref={buttonRef}\r\n            className=\"live-assistant-fab\"\r\n            data-assistant=\"true\"\r\n            style={style}\r\n            onPointerDown={handlePointerDown}\r\n            onClick={handleClick}\r\n            aria-label={ariaLabel}\r\n            title={ariaLabel}\r\n        >\r\n            <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}}>mic</span>\r\n        </button>\r\n    );\r\n};\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\EditSlotModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":103,"column":24,"nodeType":"JSXAttribute","endLine":103,"endColumn":158},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-typescale-body-medium)]' not allowed. Use MD3 tokens in inline styles.","line":103,"column":24,"nodeType":"JSXAttribute","endLine":103,"endColumn":158},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":108,"column":26,"nodeType":"JSXAttribute","endLine":108,"endColumn":55},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":115,"column":22,"nodeType":"JSXAttribute","endLine":115,"endColumn":215},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'bg-[var(--md-sys-color-surface-container-low)]est' not allowed. Use MD3 tokens in inline styles.","line":115,"column":22,"nodeType":"JSXAttribute","endLine":115,"endColumn":215},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-[var(--md-sys-shape-corner-extra-large)]' not allowed. Use MD3 tokens in inline styles.","line":115,"column":22,"nodeType":"JSXAttribute","endLine":115,"endColumn":215},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'border-[var(--md-sys-color-outline-variant)]/30' not allowed. Use MD3 tokens in inline styles.","line":115,"column":22,"nodeType":"JSXAttribute","endLine":115,"endColumn":215},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-inner' not allowed. Use MD3 tokens in inline styles.","line":115,"column":22,"nodeType":"JSXAttribute","endLine":115,"endColumn":215},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":117,"column":30,"nodeType":"JSXAttribute","endLine":117,"endColumn":75},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":118,"column":34,"nodeType":"JSXAttribute","endLine":118,"endColumn":60},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":166,"column":30,"nodeType":"JSXAttribute","endLine":166,"endColumn":75},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":180,"column":30,"nodeType":"JSXAttribute","endLine":180,"endColumn":75},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":196,"column":134,"nodeType":"JSXAttribute","endLine":196,"endColumn":165},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":201,"column":65,"nodeType":"JSXAttribute","endLine":201,"endColumn":123},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'shadow-[var(--md-sys-elevation-level3)]' not allowed. Use MD3 tokens in inline styles.","line":201,"column":65,"nodeType":"JSXAttribute","endLine":201,"endColumn":123}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from 'react';\r\nimport { Slot, Lezione, TimetableSettings, AiSettings, Uda, KnowledgeBaseEntry, PianoInclusione, Studente } from '../types';\r\nimport { M3ChoiceCard, InfoCard, SectionHeader, M3Dialog, M3DialogContent, M3DialogActions, M3Button, TextField, SelectField, TextArea } from './ui';\r\n\r\ninterface EditSlotModalProps {\r\n    slot: Slot;\r\n    lesson?: Lezione;\r\n    allLessons?: Record<string, Lezione>;\r\n    allSlots?: Record<string, Slot>;\r\n    udas?: Uda[];\r\n    onClose: () => void;\r\n    onSave?: (slotKey: string, slotData: Slot) => void;\r\n    onDelete?: (slotKey: string) => void;\r\n    onSaveLesson: (lesson: Lezione, slotKey: string) => void;\r\n    onStartClassroom?: (classe: string, materia: string, slotKey: string, lesson: Lezione) => void;\r\n    timetableSettings: TimetableSettings;\r\n    userClasses: string[];\r\n    aiSettings?: AiSettings;\r\n    students?: Studente[];\r\n    knowledgeBase?: KnowledgeBaseEntry[];\r\n    pianiInclusione?: Record<string, PianoInclusione>;\r\n}\r\n\r\ntype ActivityType = 'standard' | 'disposizione' | 'ricevimento';\r\n\r\nconst EditSlotModal: React.FC<EditSlotModalProps> = ({\r\n    slot,\r\n    lesson,\r\n    onClose,\r\n    onDelete = () => {},\r\n    onSaveLesson,\r\n    timetableSettings,\r\n    userClasses,\r\n}) => {\r\n    const slotKey = `${slot.giorno}-${slot.ora}`;\r\n\r\n    const initialType = useMemo<ActivityType>(() => {\r\n        if (lesson?.tipoLezione === 'Disposizione') return 'disposizione';\r\n        if (lesson?.tipoLezione === 'Ricevimento') return 'ricevimento';\r\n        return 'standard';\r\n    }, [lesson]);\r\n\r\n    const [activityType, setActivityType] = useState<ActivityType>(initialType);\r\n    const [currentSlot, setCurrentSlot] = useState<Slot>(slot);\r\n    const [currentLesson, setCurrentLesson] = useState<Partial<Lezione>>(lesson || { tipoLezione: 'Teoria' });\r\n\r\n    const handleSave = () => {\r\n        if (activityType === 'standard') {\r\n            if (!currentSlot.classe || !currentSlot.materia) {\r\n                alert('Classe e Materia sono obbligatorie.');\r\n                return;\r\n            }\r\n            const newLesson: Lezione = {\r\n                id: lesson?.id || `les-${Date.now()}`,\r\n                classe: currentSlot.classe,\r\n                materia: currentSlot.materia,\r\n                contenuto: currentLesson.contenuto || 'Lezione',\r\n                svolta: false,\r\n                tipoLezione: (currentLesson.tipoLezione as Lezione['tipoLezione']) || 'Teoria',\r\n                ...currentLesson,\r\n            };\r\n            onSaveLesson(newLesson, slotKey);\r\n        } else if (activityType === 'disposizione') {\r\n            const newLesson: Lezione = {\r\n                id: lesson?.id || `disp-${Date.now()}`,\r\n                classe: 'N/A',\r\n                materia: 'Disposizione',\r\n                contenuto: 'Sostituzione / Disposizione',\r\n                svolta: true,\r\n                tipoLezione: 'Disposizione',\r\n                nota: currentLesson.nota || '',\r\n            };\r\n            onSaveLesson(newLesson, slotKey);\r\n        } else {\r\n            const newLesson: Lezione = {\r\n                id: lesson?.id || `ricev-${Date.now()}`,\r\n                classe: 'N/A',\r\n                materia: 'Ricevimento',\r\n                contenuto: 'Ricevimento Genitori',\r\n                svolta: true,\r\n                tipoLezione: 'Ricevimento',\r\n                nota: currentLesson.nota || '',\r\n            };\r\n            onSaveLesson(newLesson, slotKey);\r\n        }\r\n        onClose();\r\n    };\r\n\r\n    return (\r\n        <M3Dialog\r\n            title=\"Pianificazione Slot\"\r\n            onClose={onClose}\r\n            maxWidth=\"lg\"\r\n            level={1}\r\n        >\r\n            <M3DialogContent style={{\r\n  marginTop: 'var(--md-sys-spacing-8)'\r\n}}>\r\n                <div style={{\r\n  paddingLeft: 'var(--md-sys-spacing-4)',\r\n  paddingRight: 'var(--md-sys-spacing-4)'\r\n}}>\r\n                    <p className=\"text-[var(--md-sys-typescale-body-medium)] font-[var(--md-sys-typescale-body-medium-font)] font-extrabold tracking-[0.2em]\" style={{ color: \"var(--md-sys-color-primary)\", textTransform: \"uppercase\" }}>{slot.giorno} ÔÇó {slot.ora}</p>\r\n                </div>\r\n\r\n                <section>\r\n                    <SectionHeader title=\"Tipologia Attivit├á\" icon=\"category\" />\r\n                    <div className=\"pb-2 no-scrollbar\" style={{ display: \"flex\", gap: \"var(--md-sys-spacing-6)\", overflowX: \"auto\", marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                        <M3ChoiceCard icon=\"school\" label=\"Lezione\" selected={activityType === 'standard'} onClick={() => setActivityType('standard')} />\r\n                        <M3ChoiceCard icon=\"pending_actions\" label=\"Disp.\" selected={activityType === 'disposizione'} onClick={() => setActivityType('disposizione')} />\r\n                        <M3ChoiceCard icon=\"diversity_3\" label=\"Ricev.\" selected={activityType === 'ricevimento'} onClick={() => setActivityType('ricevimento')} />\r\n                    </div>\r\n                </section>\r\n\r\n                <div className=\"bg-[var(--md-sys-color-surface-container-low)]est md:p-6 rounded-[var(--md-sys-shape-corner-extra-large)] md:rounded-4xl border-[var(--md-sys-color-outline-variant)]/30 shadow-inner\" style={{ padding: \"var(--md-sys-spacing-8)\", border: \"1px solid var(--md-sys-color-outline)\" }}>\r\n                    {activityType === 'standard' && (\r\n                        <div className=\"animate-in slide-in-from-bottom-4\" style={{ gap: \"var(--md-sys-spacing-6)\" }}>\r\n                            <div className=\"md:grid-cols-2\" style={{ display: \"grid\", gridTemplateColumns: \"1fr\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                                <SelectField\r\n                                    id=\"slot-class-select\"\r\n                                    label=\"Classe\"\r\n                                    value={currentSlot.classe || ''}\r\n                                    onChange={e => setCurrentSlot({ ...currentSlot, classe: e.target.value })}\r\n                                    required\r\n                                >\r\n                                    <option value=\"\">Seleziona...</option>\r\n                                    {userClasses.map(c => (\r\n                                        <option key={c} value={c}>{c}</option>\r\n                                    ))}\r\n                                </SelectField>\r\n\r\n                                <SelectField\r\n                                    id=\"slot-materia-select\"\r\n                                    label=\"Materia\"\r\n                                    value={currentSlot.materia || ''}\r\n                                    onChange={e => setCurrentSlot({ ...currentSlot, materia: e.target.value })}\r\n                                    required\r\n                                >\r\n                                    <option value=\"\">Seleziona...</option>\r\n                                    {timetableSettings.disciplines.map(d => (\r\n                                        <option key={d} value={d}>{d}</option>\r\n                                    ))}\r\n                                </SelectField>\r\n                            </div>\r\n\r\n                            <TextField\r\n                                id=\"slot-argomento-input\"\r\n                                label=\"Argomento (Opzionale)\"\r\n                                value={currentLesson.contenuto || ''}\r\n                                onChange={e => setCurrentLesson({ ...currentLesson, contenuto: e.target.value })}\r\n                                placeholder=\"Cosa spiegherai?\"\r\n                            />\r\n\r\n                            <TextField\r\n                                id=\"slot-ai-link-input\"\r\n                                label=\"Link AI NotebookLM\"\r\n                                value={currentLesson.externalLink || ''}\r\n                                onChange={e => setCurrentLesson({ ...currentLesson, externalLink: e.target.value })}\r\n                                placeholder=\"Incolla URL deliverable...\"\r\n                                leadingIcon=\"auto_awesome\"\r\n                            />\r\n                        </div>\r\n                    )}\r\n\r\n                    {activityType === 'disposizione' && (\r\n                        <div className=\"animate-in slide-in-from-bottom-4\" style={{ gap: \"var(--md-sys-spacing-4)\" }}>\r\n                            <InfoCard title=\"Ora di Disposizione\" description=\"Registra la tua presenza per sostituzioni o attivit├á di plesso.\" icon=\"pending_actions\" variant=\"secondary\" />\r\n                            <TextArea\r\n                                id=\"slot-disp-nota\"\r\n                                label=\"Note Disposizione\"\r\n                                value={currentLesson.nota || ''}\r\n                                onChange={e => setCurrentLesson({ ...currentLesson, nota: e.target.value })}\r\n                                placeholder=\"Es. Sostituzione in 2B\"\r\n                                rows={3}\r\n                            />\r\n                        </div>\r\n                    )}\r\n\r\n                    {activityType === 'ricevimento' && (\r\n                        <div className=\"animate-in slide-in-from-bottom-4\" style={{ gap: \"var(--md-sys-spacing-4)\" }}>\r\n                            <InfoCard title=\"Colloquio Genitori\" description=\"Spazio dedicato al ricevimento delle famiglie.\" icon=\"diversity_3\" variant=\"tertiary\" />\r\n                            <TextArea\r\n                                id=\"slot-ricev-nota\"\r\n                                label=\"Note / Orario\"\r\n                                value={currentLesson.nota || ''}\r\n                                onChange={e => setCurrentLesson({ ...currentLesson, nota: e.target.value })}\r\n                                placeholder=\"Es. Colloqui settimanali\"\r\n                                rows={3}\r\n                            />\r\n                        </div>\r\n                    )}\r\n                </div>\r\n            </M3DialogContent>\r\n            <M3DialogActions>\r\n                {lesson && (\r\n                    <M3Button onClick={() => { if (window.confirm('Eliminare?')) { onDelete(slotKey); onClose(); } }} variant=\"text\" className=\"!text-error mr-auto\">\r\n                        Rimuovi\r\n                    </M3Button>\r\n                )}\r\n                <M3Button onClick={onClose} variant=\"text\">Annulla</M3Button>\r\n                <M3Button onClick={handleSave} variant=\"filled\" className=\"shadow-[var(--md-sys-elevation-level3)] !px-10\">Conferma</M3Button>\r\n            </M3DialogActions>\r\n        </M3Dialog>\r\n    );\r\n};\r\n\r\nexport default EditSlotModal;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\EditableContentCard.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":34,"column":21,"nodeType":"JSXAttribute","endLine":34,"endColumn":42},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":44,"column":13,"nodeType":"JSXAttribute","endLine":44,"endColumn":133},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'rounded-m' not allowed. Use MD3 tokens in inline styles.","line":44,"column":13,"nodeType":"JSXAttribute","endLine":44,"endColumn":133},{"ruleId":"react/jsx-no-duplicate-props","severity":2,"message":"No duplicate props allowed","line":47,"column":13,"nodeType":"JSXAttribute","messageId":"noDuplicateProps","endLine":47,"endColumn":40},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":50,"column":21,"nodeType":"JSXAttribute","endLine":50,"endColumn":86},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]' not allowed. Use MD3 tokens in inline styles.","line":50,"column":21,"nodeType":"JSXAttribute","endLine":50,"endColumn":86},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":51,"column":36,"nodeType":"JSXAttribute","endLine":51,"endColumn":119},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":57,"column":25,"nodeType":"JSXAttribute","endLine":57,"endColumn":63},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":75,"column":29,"nodeType":"JSXAttribute","endLine":75,"endColumn":69},{"ruleId":"react/jsx-no-duplicate-props","severity":2,"message":"No duplicate props allowed","line":79,"column":29,"nodeType":"JSXAttribute","messageId":"noDuplicateProps","endLine":79,"endColumn":165},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":82,"column":60,"nodeType":"JSXAttribute","endLine":82,"endColumn":105},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":83,"column":58,"nodeType":"JSXAttribute","endLine":83,"endColumn":105},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":87,"column":26,"nodeType":"JSXAttribute","endLine":87,"endColumn":89},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'text-[var(--md-sys-color-on-surface)]-variant' not allowed. Use MD3 tokens in inline styles.","line":87,"column":26,"nodeType":"JSXAttribute","endLine":87,"endColumn":89}],"suppressedMessages":[],"errorCount":14,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\r\n\r\ninterface EditableContentCardProps {\r\n  title: string;\r\n  content: string; // The content will be a single string, newlines for lists\r\n  onSave: (newContent: string) => void;\r\n  icon?: string;\r\n}\r\n\r\nconst EditableContentCard: React.FC<EditableContentCardProps> = ({ title, content, onSave, icon }) => {\r\n    const [isEditing, setIsEditing] = useState(false);\r\n    const [currentContent, setCurrentContent] = useState(content);\r\n\r\n    useEffect(() => {\r\n        if (!isEditing) {\r\n            setCurrentContent(content);\r\n        }\r\n    }, [content, isEditing]);\r\n\r\n    const handleSave = () => {\r\n        onSave(currentContent);\r\n        setIsEditing(false);\r\n    };\r\n\r\n    const handleCancel = () => {\r\n        setCurrentContent(content); // Revert to original content\r\n        setIsEditing(false);\r\n    };\r\n\r\n    const renderContent = () => {\r\n        const lines = content.split('\\n').filter(line => line.trim() !== '');\r\n        if (lines.length > 1 || content.startsWith('ÔÇó ') || content.startsWith('- ')) {\r\n            return (\r\n                <ul className=\"list-disc\" style={{ paddingLeft: \"var(--md-sys-spacing-5)\", gap: \"var(--md-sys-spacing-1)\" }}>\r\n                    {lines.map((item, index) => <li key={index}>{item.replace(/^[ÔÇó-]\\s*/, '').trim()}</li>)}\r\n                </ul>\r\n            );\r\n        }\r\n        return <p>{content}</p>;\r\n    }\r\n\r\n    return (\r\n        <div\r\n            className=\"m3-card surface-container-high elevation-1 rounded-m transition-shadow duration-300 focus-within:elevation-2\" style={{ padding: \"var(--md-sys-spacing-8)\" }}\r\n            tabIndex={0}\r\n            aria-label={title}\r\n            style={{ outline: 'none' }}\r\n        >\r\n            <div style={{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"flex-start\" }}>\r\n                <h3 className=\"m3-title-medium text-[var(--md-sys-color-on-surface)]\" style={{ display: \"flex\", alignItems: \"center\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                    {icon && <span className=\"material-symbols-outlined text-[var(--md-sys-color-on-surface)]-variant\" aria-hidden=\"true\">{icon}</span>}\r\n                    {title}\r\n                </h3>\r\n                {!isEditing && (\r\n                    <button\r\n                        onClick={() => setIsEditing(true)}\r\n                        className=\"icon-button m3-interactive\"\r\n                        aria-label=\"Modifica contenuto\"\r\n                        tabIndex={0}\r\n                        style={{ background: 'var(--md-sys-color-surface-container-high)', borderRadius: 'var(--shape-s)' }}\r\n                    >\r\n                        <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}} aria-hidden=\"true\">edit</span>\r\n                    </button>\r\n                )}\r\n            </div>\r\n\r\n            <div style={{ marginTop: \"var(--md-sys-spacing-4)\" }}>\r\n                {isEditing ? (\r\n                    <div style={{ gap: \"var(--md-sys-spacing-2)\" }}>\r\n                        <textarea\r\n                            value={currentContent}\r\n                            onChange={(e) => setCurrentContent(e.target.value)}\r\n                            className=\"form-textarea m3-interactive\" style={{ width: \"100%\" }}\r\n                            rows={Math.max(5, currentContent.split('\\n').length)}\r\n                            autoFocus\r\n                            aria-label=\"Modifica contenuto\"\r\n                            style={{ borderRadius: 'var(--shape-s)', background: 'var(--md-sys-color-surface-container)', color: 'var(--md-sys-color-on-surface)' }}\r\n                        />\r\n                        <div style={{ display: \"flex\", justifyContent: \"flex-end\", gap: \"var(--md-sys-spacing-8)\" }}>\r\n                            <button onClick={handleCancel} className=\"button button-text m3-interactive\" aria-label=\"Annulla modifica\">Annulla</button>\r\n                            <button onClick={handleSave} className=\"button button-filled m3-interactive\" aria-label=\"Salva contenuto\">Salva</button>\r\n                        </div>\r\n                    </div>\r\n                ) : (\r\n                    <div className=\"prose text-[var(--md-sys-color-on-surface)]-variant\">\r\n                        {renderContent()}\r\n                    </div>\r\n                )}\r\n            </div>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default EditableContentCard;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ErrorBoundary.functional.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":19,"column":10,"nodeType":"JSXAttribute","endLine":19,"endColumn":68},{"ruleId":"design-system/no-