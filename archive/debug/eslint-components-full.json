ame not allowed in UI components. Use inline style with MD3 tokens instead.","line":115,"column":26,"nodeType":"JSXAttribute","endLine":115,"endColumn":109},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":116,"column":32,"nodeType":"JSXAttribute","endLine":116,"endColumn":79},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":117,"column":32,"nodeType":"JSXAttribute","endLine":117,"endColumn":85},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":120,"column":27,"nodeType":"JSXAttribute","endLine":120,"endColumn":81},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":122,"column":31,"nodeType":"JSXAttribute","endLine":122,"endColumn":90},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":130,"column":17,"nodeType":"JSXAttribute","endLine":130,"endColumn":87},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":143,"column":14,"nodeType":"JSXAttribute","endLine":143,"endColumn":46}],"suppressedMessages":[],"errorCount":18,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\r\n/* M3Expressive - ClassroomTools Component */\r\n\r\nimport React, { useState, useRef, useEffect } from 'react';\r\nimport { Studente } from '../types';\r\n\r\ninterface ClassroomToolsProps {\r\n    students: Studente[];\r\n    studentAttendance: Record<string, 'presente' | 'assente' | 'ritardo'>;\r\n}\r\n\r\nconst TimerWidget: React.FC = () => {\r\n    const [time, setTime] = useState(0);\r\n    const [isActive, setIsActive] = useState(false);\r\n    const intervalRef = useRef<number | null>(null);\r\n\r\n    useEffect(() => {\r\n        if (isActive) {\r\n            intervalRef.current = window.setInterval(() => {\r\n                setTime(prev => prev + 1);\r\n            }, 1000);\r\n        } else if (intervalRef.current) {\r\n            clearInterval(intervalRef.current);\r\n        }\r\n        return () => {\r\n            if (intervalRef.current) clearInterval(intervalRef.current);\r\n        };\r\n    }, [isActive]);\r\n\r\n    const formatTime = (totalSeconds: number) => {\r\n        const minutes = Math.floor(totalSeconds / 60);\r\n        const seconds = totalSeconds % 60;\r\n        return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;\r\n    };\r\n\r\n    const handleStartPause = () => setIsActive(!isActive);\r\n    const handleReset = () => {\r\n        setIsActive(false);\r\n        setTime(0);\r\n    };\r\n\r\n    return (\r\n        <div className=\"classroom-tools-timer-widget\">\r\n            {/* Background Decor */}\r\n            <div className=\"classroom-tools-timer-background-decor material-symbols-outlined\">\r\n                 timer\r\n            </div>\r\n            \r\n            <div className=\"classroom-tools-timer-header\">\r\n                <span className=\"classroom-tools-timer-icon material-symbols-outlined\">timer</span>\r\n                <span className=\"classroom-tools-timer-title\">Cronometro</span>\r\n            </div>\r\n            \r\n            <div className=\"classroom-tools-timer-display\">\r\n                {formatTime(time)}\r\n            </div>\r\n            \r\n            <div className=\"classroom-tools-timer-controls\">\r\n                <button \r\n                    onClick={handleReset} \r\n                    className=\"classroom-tools-timer-reset-button button button-tonal\" \r\n                    title=\"Reset\"\r\n                >\r\n                    <span style={{\r\n  fontFamily: 'Material Symbols Outlined'\r\n}}>restart_alt</span>\r\n                </button>\r\n                <button \r\n                    onClick={handleStartPause} \r\n                    className={`classroom-tools-timer-start-pause-button button ${isActive ? 'button-outlined' : 'button-filled'}`}\r\n                >\r\n                    <span className=\"material-symbols-outlined\" style={{ marginRight: \"0.5rem\" }}>{isActive ? 'pause' : 'play_arrow'}</span>\r\n                    {isActive ? 'Pausa' : 'Avvia'}\r\n                </button>\r\n            </div>\r\n        </div>\r\n    );\r\n};\r\n\r\n\r\nconst RandomStudentWidget: React.FC<{ presentStudents: Studente[] }> = ({ presentStudents }) => {\r\n    const [selectedStudent, setSelectedStudent] = useState<Studente | null>(null);\r\n    const [isSelecting, setIsSelecting] = useState(false);\r\n\r\n    const handleSelect = () => {\r\n        if (presentStudents.length === 0) return;\r\n        setIsSelecting(true);\r\n        setSelectedStudent(null);\r\n\r\n        const selectionInterval = setInterval(() => {\r\n            const randomIndex = Math.floor(Math.random() * presentStudents.length);\r\n            setSelectedStudent(presentStudents[randomIndex]);\r\n        }, 80); // Faster animation\r\n\r\n        setTimeout(() => {\r\n            clearInterval(selectionInterval);\r\n            setIsSelecting(false);\r\n        }, 1500);\r\n    };\r\n    \r\n    return (\r\n        <div className=\"classroom-tools-random-student-widget\">\r\n             {/* Background Decor */}\r\n            <div className=\"classroom-tools-random-student-background-decor material-symbols-outlined\">\r\n                 casino\r\n            </div>\r\n\r\n            <div className=\"classroom-tools-random-student-header\">\r\n                <span className=\"classroom-tools-random-student-icon material-symbols-outlined\">casino</span>\r\n                <span className=\"classroom-tools-random-student-title\">Estrazione</span>\r\n            </div>\r\n\r\n            <div className=\"classroom-tools-random-student-content\">\r\n                {selectedStudent ? (\r\n                    <div className={`classroom-tools-random-student-info ${isSelecting ? 'selecting' : ''}`}>\r\n                         <span className=\"classroom-tools-random-student-name\">{selectedStudent.cognome}</span>\r\n                         <span className=\"classroom-tools-random-student-first-name\">{selectedStudent.nome}</span>\r\n                    </div>\r\n                ) : (\r\n                     <div className=\"classroom-tools-random-student-empty-state\">\r\n                        <span className=\"classroom-tools-random-student-empty-state-icon material-symbols-outlined\">groups</span>\r\n                        <span className=\"classroom-tools-random-student-empty-state-text\">Pronto ad estrarre</span>\r\n                     </div>\r\n                )}\r\n            </div>\r\n\r\n            <button \r\n                onClick={handleSelect} \r\n                disabled={isSelecting || presentStudents.length === 0} \r\n                className=\"classroom-tools-random-student-button button button-filled\"\r\n            >\r\n                {isSelecting ? 'Estrazione...' : 'Estrai Studente'}\r\n            </button>\r\n        </div>\r\n    );\r\n};\r\n\r\n\r\nconst ClassroomTools: React.FC<ClassroomToolsProps> = ({ students, studentAttendance }) => {\r\n    const presentStudents = students.filter(s => studentAttendance[s.id] === 'presente');\r\n    \r\n    return (\r\n        <div className=\"classroom-tools-grid\">\r\n            <TimerWidget />\r\n            <RandomStudentWidget presentStudents={presentStudents} />\r\n            \r\n            {/* Placeholder for future tools to fill grid if needed */}\r\n            {/* <div className=\"md:col-span-2\"> ... </div> */}\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default ClassroomTools;\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\ClassroomView.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":186,"column":14,"nodeType":"JSXAttribute","endLine":186,"endColumn":52},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":187,"column":18,"nodeType":"JSXAttribute","endLine":187,"endColumn":51},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":190,"column":21,"nodeType":"JSXAttribute","endLine":190,"endColumn":59},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":199,"column":22,"nodeType":"JSXAttribute","endLine":199,"endColumn":67},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":200,"column":26,"nodeType":"JSXAttribute","endLine":200,"endColumn":66},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":204,"column":26,"nodeType":"JSXAttribute","endLine":204,"endColumn":176},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":212,"column":21,"nodeType":"JSXAttribute","endLine":212,"endColumn":63},{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":220,"column":18,"nodeType":"JSXAttribute","endLine":220,"endColumn":58