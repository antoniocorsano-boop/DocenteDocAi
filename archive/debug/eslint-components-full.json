ions });\r\n                        setObservationStudent(null);\r\n                    }}\r\n                />\r\n            )}\r\n\r\n            {viewingStudentProfile && (\r\n                <div className=\"fixed inset-0 z-[1600] animate-in slide-in-from-bottom-10\" style={{ backgroundColor: \"var(--md-sys-color-surface)\", overflowY: \"auto\" }}>\r\n                    <StudentProfile\r\n                        student={viewingStudentProfile}\r\n                        evaluations={evaluations.filter(e => e.studenteId === viewingStudentProfile.id)}\r\n                        competencyEvaluations={competencyEvaluations.filter(e => e.studenteId === viewingStudentProfile.id)}\r\n                        settings={settings}\r\n                        onBack={() => setViewingStudentProfile(null)}\r\n                        onDeleteEvaluation={() => {/* Handle delete */ }}\r\n                        register={[]}\r\n                        lessons={lessons}\r\n                    />\r\n                </div>\r\n            )}\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default ClassroomView;\r\n\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\CloseLessonModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\anton\\DocenteDocAI-Flowise\\docentedoc-ai\\src\\components\\CompetencyEvaluationModal.tsx","messages":[{"ruleId":"design-system/no-classname","severity":2,"message":"className not allowed in UI components. Use inline style with MD3 tokens instead.","line":66,"column":43,"nodeType":"JSXAttribute","endLine":66,"endColumn":65},{"ruleId":"design-system/no-tailwind-classes","severity":2,"message":"Tailwind class 'space-y-12' not allowed. Use MD3 tokens in inline styles.","line":66,"column":43,"nodeType":"JSXAttribute","endLine":66,"endColumn":65},