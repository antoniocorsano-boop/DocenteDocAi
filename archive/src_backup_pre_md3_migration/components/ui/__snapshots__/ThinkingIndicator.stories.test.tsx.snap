// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ThinkingIndicator Story Snapshots > renders default story correctly 1`] = `
<div>
  <div
    class="flex items-center gap-3 p-4 rounded-[var(--md-sys-shape-corner-medium)] bg-[var(--md-sys-color-surface-container-low)]/50 border border-[var(--md-sys-color-outline-variant)]/30 "
  >
    <div
      class="flex gap-1"
    >
      <div
        class="w-2 h-2 bg-primary rounded-full animate-pulse"
        style="animation-delay: 0ms;"
      />
      <div
        class="w-2 h-2 bg-primary rounded-full animate-pulse"
        style="animation-delay: 150ms;"
      />
      <div
        class="w-2 h-2 bg-primary rounded-full animate-pulse"
        style="animation-delay: 300ms;"
      />
    </div>
    <span
      class="m3-thinking-indicator text-base text-[var(--md-sys-color-on-surface)]-variant"
    >
      Pensando...
    </span>
    <div
      class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center ml-auto"
    >
      <span
        class="material-symbols-outlined text-primary text-sm"
      >
        smart_toy
      </span>
    </div>
  </div>
</div>
`;
