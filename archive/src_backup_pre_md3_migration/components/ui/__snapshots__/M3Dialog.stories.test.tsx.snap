// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`M3Dialog Story Snapshots > renders default story correctly 1`] = `
<div>
  <div
    class="dialog-backdrop"
    data-fullscreen="false"
    data-testid="m3-dialog"
    role="presentation"
    style="z-index: 1400;"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-black/40 animate-in fade-in duration-300"
    />
    <div
      aria-labelledby="dialog-title"
      aria-modal="true"
      class="dialog-container w-full max-w-lg max-h-[90vh] "
      role="dialog"
    >
      <div
        class="dialog-header"
      >
        <div>
          <h2
            class="text-[var(--md-sys-typescale-headline-small)] font-[var(--md-sys-typescale-headline-small-font)] font-black text-[var(--md-sys-color-on-surface)] tracking-tight"
            id="dialog-title"
          >
            Test Dialog
          </h2>
        </div>
        <button
          aria-label="Chiudi"
          class="icon-button hover:bg-[var(--md-sys-color-surface-container-highest)] flex items-center justify-center transition-colors"
          data-focus-priority="-1"
        >
          <span
            class="material-symbols-outlined"
          >
            close
          </span>
        </button>
      </div>
      <div
        class="dialog-content"
      >
        Test content
      </div>
    </div>
  </div>
</div>
`;
