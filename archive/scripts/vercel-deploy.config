# Vercel Deployment Configuration for DocenteDoc AI

# 1. Build & Output Settings
[build]
  command = "npm run build"
  publish = "dist"

# 2. Install dependencies
[install]
  command = "npm install"

# 3. Vercel Project Settings (vercel.json)
[vercel]
  version = 2
  builds = [
    { "src": "vite.config.ts", "use": "@vercel/node" },
    { "src": "dist/**", "use": "@vercel/static" }
  ]
  routes = [
    { "src": "/(.*)", "dest": "/index.html" }
  ]

# 4. Environment Variables (set in Vercel dashboard)
# - VITE_GSI_CLIENT_ID
# - VITE_ENABLE_GSI_DEV
# - Any other secrets required

# 5. Notes
# - Ensure vite.config.ts is configured for relative base path if needed
# - Service worker and PWA features are supported
# - All static assets are served from /dist
# - For SPA routing, all routes fallback to /index.html
